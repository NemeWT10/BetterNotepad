<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure-logic tests. The app project is deliberately NOT referenced: the source files under test
       are linked in, so the tests build and run independently of the app (WPF UI, AvalonEdit, ...). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>BetterNotepad.Tests</RootNamespace>
    <AssemblyName>BetterNotepad.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\BetterNotepad\Documents\DocumentKind.cs" Link="Linked\DocumentKind.cs" />
    <Compile Include="..\..\src\BetterNotepad\Documents\Files\TextFileIO.cs" Link="Linked\TextFileIO.cs" />
    <Compile Include="..\..\src\BetterNotepad\Documents\Diff\LineDiff.cs" Link="Linked\LineDiff.cs" />
    <Compile Include="..\..\src\BetterNotepad\Core\FileUtil.cs" Link="Linked\FileUtil.cs" />
    <Compile Include="..\..\src\BetterNotepad\Core\Commands\KeyChord.cs" Link="Linked\KeyChord.cs" />
    <Compile Include="..\..\src\BetterNotepad\UI\Windows\PinGeometry.cs" Link="Linked\PinGeometry.cs" />
    <Compile Include="..\..\src\BetterNotepad\Editor\Export\RichCode.cs" Link="Linked\RichCode.cs" />
    <Compile Include="..\..\src\BetterNotepad\Editor\Export\CodeWrap.cs" Link="Linked\CodeWrap.cs" />
    <Compile Include="..\..\src\BetterNotepad\Modules\Explorer\ExplorerRules.cs" Link="Linked\ExplorerRules.cs" />
    <!-- Languages may be split into several partial files by the syntax-definition work. -->
    <Compile Include="..\..\src\BetterNotepad\Editor\Highlighting\Languages*.cs" Link="Linked\%(Filename)%(Extension)" />
    <!-- CSV / TSV engine (no UI) + the table's dialect override (plain data, no WPF types) -->
    <Compile Include="..\..\src\BetterNotepad.Tabular\*.cs" Link="Linked\Tabular\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\BetterNotepad.Tabular.Wpf\CsvPreviewLabels.cs" Link="Linked\Tabular\CsvPreviewLabels.cs" />
  </ItemGroup>

</Project>

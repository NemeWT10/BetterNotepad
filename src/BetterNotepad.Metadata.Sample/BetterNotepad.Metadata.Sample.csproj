<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console harness: builds fixtures (JPEG/PNG/WebP/PDF/Office), exercises BetterNotepad.Metadata, verifies results and writes
       tests\output\metadata\report.txt. PDFium (test-only) is used as an independent PDF parser; WPF decoders as independent image readers. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>BetterNotepad.Metadata.Sample</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BetterNotepad.Metadata\BetterNotepad.Metadata.csproj" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="157.0.8086" />
  </ItemGroup>

</Project>

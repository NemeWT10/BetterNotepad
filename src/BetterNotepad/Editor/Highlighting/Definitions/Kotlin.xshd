<?xml version="1.0" encoding="utf-8"?>
<!-- BetterNotepad syntax definition: Kotlin. Colors are SyntaxToken names; the active theme paints them. -->
<SyntaxDefinition name="Kotlin" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" exampleText="public static void"/>
  <Color name="Control" exampleText="if (x) return;"/>
  <Color name="Type" exampleText="int string"/>
  <Color name="Function" exampleText="Foo(bar)"/>
  <Color name="Variable" exampleText="$value"/>
  <Color name="Property" exampleText="obj.Name"/>
  <Color name="String" exampleText="&quot;text&quot;"/>
  <Color name="Number" exampleText="0xFF 3.14"/>
  <Color name="Constant" exampleText="true null"/>
  <Color name="Comment" exampleText="// comment"/>
  <Color name="DocComment" exampleText="/// summary"/>
  <Color name="Operator" exampleText="+ - =&gt;"/>
  <Color name="Punctuation" exampleText="{ } ( ) ;"/>
  <Color name="Attribute" exampleText="[Serializable]"/>
  <Color name="Escape" exampleText="\n \t"/>
  <Color name="Directive" exampleText=".text"/>
  <Color name="Label" exampleText="loop:"/>
  <Color name="Link" exampleText="[text](url)"/>

  <RuleSet>
    <Span color="DocComment" multiline="true" ruleSet="Doc" begin="/\*[*!](?![*/])" end="\*/"/>
    <Span color="Comment" multiline="true" ruleSet="Cmt" begin="/\*(?![*!](?![*/]))" end="\*/"/>
    <Span color="Comment" ruleSet="Cmt" begin="//"/>
    <Span color="String" multiline="true" ruleSet="KtRaw" begin="&quot;&quot;&quot;" end="&quot;&quot;&quot;"/>
    <Span color="String" ruleSet="KtEsc" begin="&quot;(?!&quot;&quot;)" end="&quot;"/>
    <Span color="String" ruleSet="Esc" begin="'" end="'"/>
    <Rule color="Attribute">@(?:(?:file|field|get|set|param|property|receiver|delegate|setparam):)?[A-Za-z_]\w*</Rule>
    <Rule color="Label">\b\w+@(?=\s)|(?&lt;=\b(?:return|break|continue|this|super)@)\w+</Rule>
    <Rule color="Control">(?&lt;![\w.])(?:continue|finally|return|break|catch|throw|while|else|when|for|try|do|if)\b</Rule>
    <Rule color="Keyword">(?&lt;![\w.])(?:
      constructor|companion|interface|protected|typealias|abstract|internal|override|dynamic|package|
      private|import|object|public|sealed|typeof|class|const|final|super|where|enum|init|this|fun|get|out|
      set|val|var|as|by|in|is
    )\b</Rule>
    <Rule color="Keyword">(?&lt;![\w.])(?:
      crossinline|annotation|delegate|external|lateinit|noinline|operator|reified|suspend|tailrec|actual|
      expect|inline|vararg|infix|inner|value|data|open
    )\b(?=\s+(?!(?:is|in|as|to|and|or|else|then)\b)[A-Za-z_@])</Rule>
    <Rule color="Constant">(?&lt;![\w.])(?:false|null|true)\b</Rule>
    <Rule color="Type">(?&lt;=\b(?:class|interface|object|typealias)\s+)[A-Za-z_]\w*</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F_]+[uU]?[lL]?\b</Rule>
    <Rule color="Number">\b0[bB][01_]+[uU]?[lL]?\b</Rule>
    <Rule color="Number">\b0[oO][0-7_]+[uU]?[lL]?\b</Rule>
    <Rule color="Number">(?:(?&lt;![\w.])|(?&lt;=\.\.))(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?(?:[uU]?[lL]?|[fF])\b</Rule>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Constant">\b[A-Z][A-Z0-9_]{2,}\b</Rule>
    <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*\b</Rule>
    <Rule color="Type">\b[A-Z]\w*\b</Rule>
    <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
    <Rule color="Punctuation">[{}()\[\];,.:]</Rule>
  </RuleSet>

  <RuleSet name="Esc">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="Cmt">
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="Doc">
    <Rule color="Directive">(?&lt;![\w])[@\\][A-Za-z]+</Rule>
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="KtEsc">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
    <Rule color="Variable">\$[A-Za-z_]\w*</Rule>
    <Span color="Variable">
      <Begin color="Punctuation">\$\{</Begin>
      <End color="Punctuation">\}</End>
      <RuleSet>
        <Span color="String" ruleSet="KtEsc" begin="&quot;" end="&quot;"/>
        <Span color="String" ruleSet="Esc" begin="'" end="'"/>
        <Rule color="Keyword">(?&lt;![\w.])(?:super|this|as|in|is|it)\b</Rule>
        <Rule color="Constant">\b(?:false|null|true)\b</Rule>
        <Rule color="Number">\b0[xX][0-9a-fA-F_]+[uU]?[lL]?\b</Rule>
        <Rule color="Number">\b0[bB][01_]+[uU]?[lL]?\b</Rule>
        <Rule color="Number">\b0[oO][0-7_]+[uU]?[lL]?\b</Rule>
        <Rule color="Number">(?:(?&lt;![\w.])|(?&lt;=\.\.))(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?(?:[uU]?[lL]?|[fF])\b</Rule>
        <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
        <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*\b</Rule>
        <Rule color="Type">\b[A-Z]\w*\b</Rule>
        <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
        <Rule color="Punctuation">[()\[\],.]+</Rule>
      </RuleSet>
    </Span>
  </RuleSet>

  <RuleSet name="KtRaw">
    <Rule color="Variable">\$[A-Za-z_]\w*</Rule>
    <Span color="Variable">
      <Begin color="Punctuation">\$\{</Begin>
      <End color="Punctuation">\}</End>
      <RuleSet>
        <Span color="String" ruleSet="KtEsc" begin="&quot;" end="&quot;"/>
        <Span color="String" ruleSet="Esc" begin="'" end="'"/>
        <Rule color="Keyword">(?&lt;![\w.])(?:super|this|as|in|is|it)\b</Rule>
        <Rule color="Constant">\b(?:false|null|true)\b</Rule>
        <Rule color="Number">\b0[xX][0-9a-fA-F_]+[uU]?[lL]?\b</Rule>
        <Rule color="Number">\b0[bB][01_]+[uU]?[lL]?\b</Rule>
        <Rule color="Number">\b0[oO][0-7_]+[uU]?[lL]?\b</Rule>
        <Rule color="Number">(?:(?&lt;![\w.])|(?&lt;=\.\.))(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?(?:[uU]?[lL]?|[fF])\b</Rule>
        <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
        <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*\b</Rule>
        <Rule color="Type">\b[A-Z]\w*\b</Rule>
        <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
        <Rule color="Punctuation">[()\[\],.]+</Rule>
      </RuleSet>
    </Span>
  </RuleSet>
</SyntaxDefinition>

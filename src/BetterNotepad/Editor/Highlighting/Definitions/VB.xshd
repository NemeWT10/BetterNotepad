<?xml version="1.0" encoding="utf-8"?>
<!-- BetterNotepad syntax definition: VB. Colors are SyntaxToken names; the active theme paints them. -->
<SyntaxDefinition name="VB" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" exampleText="public static void"/>
  <Color name="Control" exampleText="if (x) return;"/>
  <Color name="Type" exampleText="int string"/>
  <Color name="Function" exampleText="Foo(bar)"/>
  <Color name="Variable" exampleText="$value"/>
  <Color name="Property" exampleText="obj.Name"/>
  <Color name="String" exampleText="&quot;text&quot;"/>
  <Color name="Number" exampleText="0xFF 3.14"/>
  <Color name="Constant" exampleText="true null"/>
  <Color name="Comment" exampleText="// comment"/>
  <Color name="DocComment" exampleText="/// summary"/>
  <Color name="Preprocessor" exampleText="#include"/>
  <Color name="Operator" exampleText="+ - =&gt;"/>
  <Color name="Punctuation" exampleText="{ } ( ) ;"/>
  <Color name="Attribute" exampleText="[Serializable]"/>
  <Color name="Escape" exampleText="\n \t"/>
  <Color name="Directive" exampleText=".text"/>
  <Color name="Label" exampleText="loop:"/>
  <Color name="Link" exampleText="[text](url)"/>

  <RuleSet ignoreCase="true">
    <Span color="DocComment" ruleSet="Cmt" begin="'''"/>
    <Span color="Comment" ruleSet="Cmt" begin="'(?!'')|(?i:(?&lt;![\w.])rem(?=\s|$))"/>
    <Span color="Preprocessor" begin="^\s*\#\s*(?i:if|else|elseif|end\s+if|region|end\s+region|const|externalsource|disable|enable)\b"/>
    <Span color="String" ruleSet="VbInterp" begin="\$&quot;" end="&quot;(?!&quot;)"/>
    <Span color="String" ruleSet="VbStr" begin="&quot;" end="&quot;(?!&quot;)"/>
    <Rule color="Number">\#[^#\n]+\#</Rule>
    <Rule color="Attribute">(?&lt;=^\s*|[\s,(])&lt;[A-Za-z_][\w.]*(?:\([^)\n]*\))?(?:\s*,\s*[A-Za-z_][\w.]*(?:\([^)\n]*\))?)*&gt;</Rule>
    <Rule color="Control">(?i:(?&lt;![\w.])(?:
      continue|finally|elseif|resume|return|select|catch|error|throw|until|while|case|each|else|exit|goto|
      loop|next|step|stop|then|wend|when|for|try|do|if|in|on|to
    )\b)</Rule>
    <Rule color="Keyword">(?i:(?&lt;![\w.])(?:
      notinheritable|notoverridable|removehandler|mustoverride|mustinherit|overridable|addhandler|
      directcast|implements|paramarray|raiseevent|withevents|addressof|interface|namespace|narrowing|
      overloads|overrides|protected|structure|writeonly|delegate|function|inherits|iterator|operator|
      optional|property|readonly|synclock|widening|andalso|declare|default|gettype|handles|imports|
      myclass|partial|private|shadows|variant|custom|friend|global|module|mybase|option|orelse|public|
      select|shared|static|typeof|alias|async|await|byref|byval|class|const|event|isnot|redim|using|where|
      yield|call|enum|like|with|and|dim|end|get|let|lib|mod|new|not|out|set|sub|xor|as|is|me|of|or
    )\b)</Rule>
    <Rule color="Type">(?i:(?&lt;![\w.])(?:
      uinteger|boolean|decimal|integer|variant|double|object|single|string|ushort|sbyte|short|ulong|byte|
      char|date|long
    )\b)</Rule>
    <Rule color="Constant">(?i:(?&lt;![\w.])(?:nothing|false|true)\b)</Rule>
    <Rule color="Type">(?&lt;=\b(?i:as|new|of|inherits|implements|imports|class|interface|structure|enum|module)\s+)[A-Za-z_][\w.]*</Rule>
    <Rule color="Number">(?&lt;![\w])&amp;[HhOoBb][0-9A-Fa-f]+[%&amp;LSIUls]*</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F]+[%&amp;@!#RDFILSUrdfilsu]{0,2}\b</Rule>
    <Rule color="Number">(?&lt;![\w.])(?:\d[\d]*(?:\.(?!\.)[\d]*)?|\.\d[\d]*)(?:[eE][+-]?\d[\d]*)?[%&amp;@!#RDFILSUrdfilsu]{0,2}\b</Rule>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*\b</Rule>
    <Rule color="Label">^\s*[A-Za-z_]\w*(?=:(?!=))</Rule>
    <Rule color="Operator">&lt;&gt;|&lt;=|&gt;=|:=|&amp;=|[-+*/\\^&amp;=&lt;&gt;]+</Rule>
    <Rule color="Punctuation">[{}()\[\];,.:]</Rule>
  </RuleSet>

  <RuleSet name="Esc" ignoreCase="true">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="Cmt" ignoreCase="true">
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="Doc" ignoreCase="true">
    <Rule color="Directive">(?&lt;![\w])[@\\][A-Za-z]+</Rule>
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="VbStr" ignoreCase="true">
    <Span color="Escape" begin="&quot;&quot;" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="VbInterp" ignoreCase="true">
    <Span color="Escape" begin="&quot;&quot;" end="(?=.)"/>
    <Span color="Escape" begin="\{\{|\}\}" end="(?=.)"/>
    <Span color="Variable">
      <Begin color="Punctuation">\{(?!\{)</Begin>
      <End color="Punctuation">\}</End>
      <RuleSet>
        <Rule color="Constant">(?i:true|false|nothing)</Rule>
        <Rule color="Number">\b0[xX][0-9a-fA-F]+\b</Rule>
        <Rule color="Number">(?&lt;![\w.])(?:\d[\d]*(?:\.(?!\.)[\d]*)?|\.\d[\d]*)(?:[eE][+-]?\d[\d]*)?\b</Rule>
        <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
        <Rule color="Property">(?&lt;=\.)\w+</Rule>
        <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
      </RuleSet>
    </Span>
  </RuleSet>
</SyntaxDefinition>

<?xml version="1.0" encoding="utf-8"?>
<!-- BetterNotepad syntax definition: Cpp. Colors are SyntaxToken names; the active theme paints them. -->
<SyntaxDefinition name="Cpp" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" exampleText="public static void"/>
  <Color name="Control" exampleText="if (x) return;"/>
  <Color name="Type" exampleText="int string"/>
  <Color name="Function" exampleText="Foo(bar)"/>
  <Color name="Property" exampleText="obj.Name"/>
  <Color name="String" exampleText="&quot;text&quot;"/>
  <Color name="Number" exampleText="0xFF 3.14"/>
  <Color name="Constant" exampleText="true null"/>
  <Color name="Comment" exampleText="// comment"/>
  <Color name="DocComment" exampleText="/// summary"/>
  <Color name="Preprocessor" exampleText="#include"/>
  <Color name="Operator" exampleText="+ - =&gt;"/>
  <Color name="Punctuation" exampleText="{ } ( ) ;"/>
  <Color name="Attribute" exampleText="[Serializable]"/>
  <Color name="Escape" exampleText="\n \t"/>
  <Color name="Directive" exampleText=".text"/>
  <Color name="Label" exampleText="loop:"/>
  <Color name="Link" exampleText="[text](url)"/>

  <RuleSet>
    <Span color="DocComment" multiline="true" ruleSet="Doc" begin="/\*[*!](?![*/])" end="\*/"/>
    <Span color="DocComment" ruleSet="Doc" begin="///(?!/)|//!"/>
    <Span color="Comment" multiline="true" ruleSet="Cmt" begin="/\*(?![*!](?![*/]))" end="\*/"/>
    <Span color="Comment" ruleSet="Cmt" begin="//(?!/(?!/))"/>
    <Rule color="Preprocessor">^\s*\#\s*(?:include_next|include|import|define|undef|ifdef|ifndef|if|elif|elifdef|elifndef|else|endif|error|warning|pragma|line|using|region|endregion)\b</Rule>
    <Rule color="String">(?&lt;=^\s*\#\s*(?:include_next|include|import)\s*)&lt;[^&gt;\n]*&gt;</Rule>
    <Rule color="Constant">(?&lt;=^\s*\#\s*(?:define|undef|ifdef|ifndef|elifdef|elifndef)\s+)[A-Za-z_]\w*</Rule>
    <Span color="String" multiline="true" begin="(?:\b(?:u8|u|U|L))?R&quot;\(" end="\)&quot;"/>
    <Span color="String" ruleSet="Esc" begin="(?:\b(?:u8|u|U|L))?&quot;" end="&quot;"/>
    <Span color="String" ruleSet="Esc" begin="(?:(?&lt;!\w)(?:u8|u|U|L)|(?&lt;!\w))'" end="'"/>
    <Span color="Attribute" begin="\[\[" end="\]\]"/>
    <Rule color="Control">\b(?:
      co_return|co_await|co_yield|continue|default|return|switch|break|catch|throw|while|case|else|goto|
      for|try|do|if
    )\b</Rule>
    <Rule color="Keyword">\b(?:
      reinterpret_cast|_Static_assert|_Thread_local|__attribute__|__forceinline|static_assert|
      __vectorcall|dynamic_cast|thread_local|__unaligned|static_cast|__declspec|__fastcall|__inline__|
      __restrict|__thiscall|__typeof__|const_cast|_Noreturn|__stdcall|consteval|constexpr|constinit|
      namespace|protected|_Alignas|_Alignof|_Generic|decltype|explicit|noexcept|noreturn|operator|
      override|register|requires|restrict|template|typename|volatile|_Atomic|_Pragma|__asm__|__cdecl|
      alignas|alignof|concept|defined|foreach|forever|mutable|private|signals|typedef|virtual|and_eq|
      bitand|delete|export|extern|friend|import|inline|module|not_eq|public|sizeof|static|struct|typeid|
      typeof|xor_eq|__asm|bitor|class|compl|const|final|or_eq|slots|union|using|auto|emit|enum|this|and|
      asm|new|not|xor|or
    )\b</Rule>
    <Rule color="Type">\b(?:
      initializer_list|invalid_argument|difference_type|istringstream|ostringstream|runtime_error|
      out_of_range|sig_atomic_t|stringstream|wstring_view|logic_error|max_align_t|string_view|WNDCLASSEX|
      _Imaginary|mt19937_64|shared_ptr|unique_ptr|value_type|DWORD_PTR|HINSTANCE|ULONG_PTR|bad_alloc|
      mbstate_t|nullptr_t|ptrdiff_t|size_type|u16string|u32string|uintmax_t|uintptr_t|COLORREF|NTSTATUS|
      WNDCLASS|_Complex|char16_t|char32_t|ifstream|intmax_t|intptr_t|iostream|ofstream|u8string|uint16_t|
      uint32_t|uint64_t|unsigned|weak_ptr|BOOLEAN|HMODULE|HRESULT|LPCTSTR|LPCWSTR|LPDWORD|LRESULT|SSIZE_T|
      char8_t|clock_t|errno_t|fstream|int16_t|int32_t|int64_t|istream|jmp_buf|mt19937|ostream|ssize_t|
      uint8_t|va_list|wchar_t|wstring|HANDLE|HBRUSH|LPARAM|LPBYTE|LPCSTR|LPTSTR|LPVOID|LPWSTR|PCWSTR|
      SIZE_T|SOCKET|UINT16|UINT32|UINT64|WPARAM|double|fpos_t|int8_t|ldiv_t|signed|size_t|string|time_t|
      DWORD|HICON|HMENU|INT16|INT32|INT64|LPSTR|PCHAR|POINT|PVOID|PWSTR|QWORD|TCHAR|UINT8|ULONG|_Bool|
      div_t|float|off_t|pid_t|short|ATOM|BOOL|BYTE|FILE|HWND|INT8|LONG|RECT|SIZE|UINT|WORD|auto|bool|char|
      long|void|DIR|HDC|INT|MSG|int
    )\b</Rule>
    <Rule color="Constant">\b(?:
      INVALID_HANDLE_VALUE|EXIT_FAILURE|EXIT_SUCCESS|__FUNCTION__|__COUNTER__|__VA_ARGS__|__cplusplus|
      monostate|CHAR_BIT|INFINITE|LONG_MAX|LONG_MIN|MAX_PATH|RAND_MAX|SEEK_CUR|SEEK_END|SEEK_SET|SIZE_MAX|
      UINT_MAX|__DATE__|__FILE__|__LINE__|__STDC__|__TIME__|__func__|INT_MAX|INT_MIN|nullopt|nullptr|
      BUFSIZ|stderr|stdout|FALSE|errno|false|flush|stdin|wcerr|wcout|NULL|TRUE|cerr|clog|cout|endl|ends|
      npos|true|wcin|EOF|cin
    )\b</Rule>
    <Rule color="Type">\b(?:std|chrono|filesystem|ranges|views|this_thread|placeholders|literals|pmr|execution|boost|Eigen|cv|absl|fmt|nlohmann|asio|tbb|folly|llvm|clang|Qt)(?=::)</Rule>
    <Rule color="Type">\b(?:
      uniform_real_distribution|uniform_int_distribution|bernoulli_distribution|normal_distribution|
      unordered_multimap|unordered_multiset|basic_string_view|reference_wrapper|priority_queue|
      packaged_task|shared_future|unordered_map|unordered_set|basic_string|forward_list|scoped_lock|
      shared_lock|unique_lock|lock_guard|time_point|allocator|generator|duration|equal_to|expected|
      function|multimap|multiset|optional|complex|greater|promise|variant|atomic|bitset|future|vector|
      array|deque|queue|ratio|stack|tuple|hash|less|list|pair|span|any|map|set
    )\b(?=\s*&lt;)</Rule>
    <Rule color="Type">(?&lt;=\b(?:std|chrono|filesystem|ranges|views|this_thread|placeholders|literals|pmr|execution)::)[A-Za-z_]\w*\b(?!\s*\()</Rule>
    <Rule color="Type">\b[A-Za-z_]\w*_t\b</Rule>
    <Rule color="Type">\bQ[A-Z]\w*\b</Rule>
    <Rule color="Preprocessor">\bQ_[A-Z_]+\b|\b(?:SIGNAL|SLOT)(?=\s*\()</Rule>
    <Rule color="Type">(?&lt;=\b(?:class|struct|union|enum|namespace|typename|new)\s+)[A-Za-z_]\w*</Rule>
    <Rule color="Type">(?&lt;=\benum\s+(?:class|struct)\s+)[A-Za-z_]\w*</Rule>
    <Rule color="Label">^\s*[A-Za-z_]\w*(?=\s*:(?!:))</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F']+[uUlLzZ]*\b</Rule>
    <Rule color="Number">\b0[bB][01']+[uUlLzZ]*\b</Rule>
    <Rule color="Number">\b0[oO][0-7']+[uUlLzZ]*\b</Rule>
    <Rule color="Number">(?&lt;![\w.])(?:\d[\d']*(?:\.(?!\.)[\d']*)?|\.\d[\d']*)(?:[eE][+-]?\d[\d']*)?[uUlLfFzZ]*\b</Rule>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Constant">\b[A-Z][A-Z0-9_]{2,}\b</Rule>
    <Rule color="Property">(?&lt;=\.|-&gt;)[A-Za-z_]\w*\b</Rule>
    <Rule color="Type">\b[A-Z]\w*\b</Rule>
    <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
    <Rule color="Punctuation">[{}()\[\];,.:]</Rule>
  </RuleSet>

  <RuleSet name="Esc">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="Cmt">
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="Doc">
    <Rule color="Directive">(?&lt;![\w])[@\\][A-Za-z]+</Rule>
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>
</SyntaxDefinition>

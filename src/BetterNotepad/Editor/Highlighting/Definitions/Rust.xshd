<?xml version="1.0" encoding="utf-8"?>
<!-- BetterNotepad syntax definition: Rust. Colors are SyntaxToken names; the active theme paints them. -->
<SyntaxDefinition name="Rust" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" exampleText="public static void"/>
  <Color name="Control" exampleText="if (x) return;"/>
  <Color name="Type" exampleText="int string"/>
  <Color name="Function" exampleText="Foo(bar)"/>
  <Color name="Property" exampleText="obj.Name"/>
  <Color name="String" exampleText="&quot;text&quot;"/>
  <Color name="Number" exampleText="0xFF 3.14"/>
  <Color name="Constant" exampleText="true null"/>
  <Color name="Comment" exampleText="// comment"/>
  <Color name="DocComment" exampleText="/// summary"/>
  <Color name="Operator" exampleText="+ - =&gt;"/>
  <Color name="Punctuation" exampleText="{ } ( ) ;"/>
  <Color name="Attribute" exampleText="[Serializable]"/>
  <Color name="Escape" exampleText="\n \t"/>
  <Color name="Directive" exampleText=".text"/>
  <Color name="Label" exampleText="loop:"/>
  <Color name="Link" exampleText="[text](url)"/>

  <RuleSet>
    <Span color="DocComment" multiline="true" ruleSet="Doc" begin="/\*[*!](?![*/])" end="\*/"/>
    <Span color="DocComment" ruleSet="Doc" begin="//[/!](?!/)"/>
    <Span color="Comment" multiline="true" ruleSet="Cmt" begin="/\*(?![*!](?![*/]))" end="\*/"/>
    <Span color="Comment" ruleSet="Cmt" begin="//(?!/(?!/))"/>
    <Span color="String" multiline="true" begin="\bb?r##&quot;" end="&quot;##"/>
    <Span color="String" multiline="true" begin="\bb?r#&quot;" end="&quot;#"/>
    <Span color="String" multiline="true" begin="\bb?r&quot;" end="&quot;"/>
    <Span color="String" multiline="true" ruleSet="Esc" begin="(?&lt;!\w)b?&quot;" end="&quot;"/>
    <Rule color="String">(?&lt;!\w)b?'(?:\\(?:x[0-9a-fA-F]{2}|u\{[0-9a-fA-F_]+\}|.)|[^\\'\n])'</Rule>
    <Rule color="Label">'[A-Za-z_]\w*\b(?!')</Rule>
    <Span color="Attribute">
      <Begin>\#!?\[</Begin>
      <End>\]</End>
      <RuleSet>
        <Span color="String" ruleSet="Esc" begin="&quot;" end="&quot;"/>
      </RuleSet>
    </Span>
    <Rule color="Function">\b[A-Za-z_]\w*!(?=\s*[(\[{])</Rule>
    <Rule color="Control">(?&lt;![\w.])(?:continue|return|break|match|while|yield|else|loop|for|if)\b</Rule>
    <Rule color="Keyword">(?&lt;![\w.])(?:
      macro_rules|extern|static|struct|unsafe|async|await|const|crate|super|trait|union|where|enum|impl|
      move|self|type|box|dyn|let|mod|mut|pub|ref|try|use|as|fn|in
    )\b</Rule>
    <Rule color="Type">(?&lt;![\w.])(?:isize|usize|bool|char|i128|u128|f32|f64|i16|i32|i64|str|u16|u32|u64|i8|u8)\b</Rule>
    <Rule color="Constant">(?&lt;![\w.])(?:false|None|true)\b</Rule>
    <Rule color="Type">\bSelf\b</Rule>
    <Rule color="Type">(?&lt;=\b(?:struct|enum|trait|union|type|impl)\s+)[A-Za-z_]\w*</Rule>
    <Rule color="Type">(?&lt;![\w.:])[a-z_]\w*(?=::)</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F_]+(?:[iu](?:8|16|32|64|128|size)|f32|f64)?\b</Rule>
    <Rule color="Number">\b0[bB][01_]+(?:[iu](?:8|16|32|64|128|size)|f32|f64)?\b</Rule>
    <Rule color="Number">\b0[oO][0-7_]+(?:[iu](?:8|16|32|64|128|size)|f32|f64)?\b</Rule>
    <Rule color="Number">(?:(?&lt;![\w.])|(?&lt;=\.\.))(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?(?:[iu](?:8|16|32|64|128|size)|f32|f64)?\b</Rule>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Property">(?&lt;=[{(,;]\s*|^\s*)[A-Za-z_]\w*(?=\s*\??:(?![:=]))</Rule>
    <Rule color="Constant">\b[A-Z][A-Z0-9_]{2,}\b</Rule>
    <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*\b</Rule>
    <Rule color="Type">\b[A-Z]\w*\b</Rule>
    <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
    <Rule color="Punctuation">[{}()\[\];,.:]</Rule>
  </RuleSet>

  <RuleSet name="Esc">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="Cmt">
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="Doc">
    <Rule color="Directive">(?&lt;![\w])[@\\][A-Za-z]+</Rule>
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>
</SyntaxDefinition>

<?xml version="1.0" encoding="utf-8"?>
<!-- BetterNotepad syntax definition: Html. Colors are SyntaxToken names; the active theme paints them. -->
<SyntaxDefinition name="Html" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="String" exampleText="&quot;text&quot;"/>
  <Color name="Comment" exampleText="// comment"/>
  <Color name="Preprocessor" exampleText="#include"/>
  <Color name="Operator" exampleText="+ - =&gt;"/>
  <Color name="Tag" exampleText="&lt;div&gt;"/>
  <Color name="AttrName" exampleText="class"/>
  <Color name="AttrValue" exampleText="&quot;main&quot;"/>
  <Color name="Entity" exampleText="&amp;amp;"/>
  <Color name="Link" exampleText="[text](url)"/>

  <RuleSet>
    <Span color="Comment" multiline="true" ruleSet="Cmt" begin="&lt;!--" end="--&gt;"/>
    <Span color="String" multiline="true" begin="&lt;!\[CDATA\[" end="\]\]&gt;"/>
    <Span color="Preprocessor" multiline="true" begin="&lt;!(?i:doctype)\b" end="&gt;"/>
    <Span multiline="true" ruleSet="HtmlScript">
      <Begin color="Tag">&lt;(?i:script)\b</Begin>
      <End color="Tag">&lt;/(?i:script)\s*&gt;</End>
    </Span>
    <Span multiline="true" ruleSet="HtmlStyle">
      <Begin color="Tag">&lt;(?i:style)\b</Begin>
      <End color="Tag">&lt;/(?i:style)\s*&gt;</End>
    </Span>
    <Span multiline="true" ruleSet="HtmlTag">
      <Begin color="Tag">&lt;/?(?!(?i:script|style)\b)[A-Za-z][\w:.-]*</Begin>
      <End color="Tag">/?&gt;</End>
    </Span>
    <Rule color="Entity">&amp;(?:[A-Za-z][\w.-]*|\#\d+|\#[xX][0-9A-Fa-f]+);</Rule>
  </RuleSet>

  <RuleSet name="Cmt">
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="Ent">
    <Rule color="Entity">&amp;(?:[A-Za-z][\w.-]*|\#\d+|\#[xX][0-9A-Fa-f]+);</Rule>
  </RuleSet>

  <RuleSet name="HtmlTag">
    <Span color="AttrValue" multiline="true" ruleSet="Ent" begin="&quot;" end="&quot;"/>
    <Span color="AttrValue" multiline="true" ruleSet="Ent" begin="'" end="'"/>
    <Rule color="AttrValue">(?&lt;==\s*)[^\s\"'=&lt;&gt;`]+</Rule>
    <Rule color="AttrName">[A-Za-z_:@#*\[(][\w:.@#*\-\])]*</Rule>
    <Rule color="Operator">=</Rule>
  </RuleSet>

  <RuleSet name="HtmlScript">
    <Span color="AttrValue" multiline="true" ruleSet="Ent" begin="&quot;" end="&quot;"/>
    <Span color="AttrValue" multiline="true" ruleSet="Ent" begin="'" end="'"/>
    <Rule color="AttrValue">(?&lt;==\s*)[^\s\"'=&lt;&gt;`]+</Rule>
    <Rule color="AttrName">[A-Za-z_:@#*\[(][\w:.@#*\-\])]*</Rule>
    <Rule color="Operator">=</Rule>
    <Span multiline="true" ruleSet="JavaScript/">
      <Begin color="Tag">&gt;</Begin>
      <End>(?=&lt;/(?i:script)\b)</End>
    </Span>
  </RuleSet>

  <RuleSet name="HtmlStyle">
    <Span color="AttrValue" multiline="true" ruleSet="Ent" begin="&quot;" end="&quot;"/>
    <Span color="AttrValue" multiline="true" ruleSet="Ent" begin="'" end="'"/>
    <Rule color="AttrValue">(?&lt;==\s*)[^\s\"'=&lt;&gt;`]+</Rule>
    <Rule color="AttrName">[A-Za-z_:@#*\[(][\w:.@#*\-\])]*</Rule>
    <Rule color="Operator">=</Rule>
    <Span multiline="true" ruleSet="Css/">
      <Begin color="Tag">&gt;</Begin>
      <End>(?=&lt;/(?i:style)\b)</End>
    </Span>
  </RuleSet>
</SyntaxDefinition>

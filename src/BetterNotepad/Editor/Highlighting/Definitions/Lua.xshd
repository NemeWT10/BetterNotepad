<?xml version="1.0" encoding="utf-8"?>
<!-- BetterNotepad syntax definition: Lua. Colors are SyntaxToken names; the active theme paints them. -->
<SyntaxDefinition name="Lua" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" exampleText="public static void"/>
  <Color name="Control" exampleText="if (x) return;"/>
  <Color name="Type" exampleText="int string"/>
  <Color name="Function" exampleText="Foo(bar)"/>
  <Color name="Variable" exampleText="$value"/>
  <Color name="Property" exampleText="obj.Name"/>
  <Color name="String" exampleText="&quot;text&quot;"/>
  <Color name="Number" exampleText="0xFF 3.14"/>
  <Color name="Constant" exampleText="true null"/>
  <Color name="Comment" exampleText="// comment"/>
  <Color name="Operator" exampleText="+ - =&gt;"/>
  <Color name="Punctuation" exampleText="{ } ( ) ;"/>
  <Color name="Attribute" exampleText="[Serializable]"/>
  <Color name="Escape" exampleText="\n \t"/>
  <Color name="Directive" exampleText=".text"/>
  <Color name="Label" exampleText="loop:"/>
  <Color name="Link" exampleText="[text](url)"/>

  <RuleSet>
    <Rule color="Comment">^\#!.*</Rule>
    <Span color="Comment" multiline="true" ruleSet="Cmt" begin="--\[\[" end="\]\]"/>
    <Span color="Comment" multiline="true" ruleSet="Cmt" begin="--\[=\[" end="\]=\]"/>
    <Span color="Comment" multiline="true" ruleSet="Cmt" begin="--\[==\[" end="\]==\]"/>
    <Span color="Comment" ruleSet="Cmt" begin="--"/>
    <Span color="String" multiline="true" begin="\[\[" end="\]\]"/>
    <Span color="String" multiline="true" begin="\[=\[" end="\]=\]"/>
    <Span color="String" multiline="true" begin="\[==\[" end="\]==\]"/>
    <Span color="String" ruleSet="LuaEsc" begin="&quot;" end="&quot;"/>
    <Span color="String" ruleSet="LuaEsc" begin="'" end="'"/>
    <Rule color="Label">::[A-Za-z_]\w*::</Rule>
    <Rule color="Attribute">&lt;(?:const|close)&gt;</Rule>
    <Rule color="Control">(?&lt;![\w.])(?:elseif|repeat|return|break|until|while|else|goto|for|if|in)\b</Rule>
    <Rule color="Keyword">(?&lt;![\w.])(?:function|local|then|and|end|not|do|or)\b</Rule>
    <Rule color="Constant">(?&lt;![\w.])(?:false|true|nil)\b</Rule>
    <Rule color="Type">(?&lt;![\w.])(?:coroutine|_VERSION|package|string|debug|table|_ENV|math|utf8|_G|io|os)\b</Rule>
    <Rule color="Variable">\bself\b</Rule>
    <Rule color="Type">(?&lt;=\bfunction\s+)[A-Za-z_]\w*(?=[.:])</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F]+\b</Rule>
    <Rule color="Number">(?&lt;![\w.])(?:\d[\d]*(?:\.(?!\.)[\d]*)?|\.\d[\d]*)(?:[eE][+-]?\d[\d]*)?\b</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F]*\.?[0-9a-fA-F]*(?:[pP][+-]?\d+)?\b</Rule>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Constant">\b[A-Z][A-Z0-9_]{2,}\b</Rule>
    <Rule color="Property">(?&lt;=[.:])[A-Za-z_]\w*\b</Rule>
    <Rule color="Operator">\.\.\.?|[-+*/%^#=&lt;&gt;~]+|//</Rule>
    <Rule color="Punctuation">[{}()\[\];,.:]</Rule>
  </RuleSet>

  <RuleSet name="Esc">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="Cmt">
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="Doc">
    <Rule color="Directive">(?&lt;![\w])[@\\][A-Za-z]+</Rule>
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="LuaEsc">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{2}|u\{[0-9A-Fa-f]+\}|\d{1,3}|z\s*|.)" end="(?=.)"/>
  </RuleSet>
</SyntaxDefinition>

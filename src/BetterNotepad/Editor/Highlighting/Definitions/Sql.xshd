<?xml version="1.0" encoding="utf-8"?>
<!-- BetterNotepad syntax definition: Sql. Colors are SyntaxToken names; the active theme paints them. -->
<SyntaxDefinition name="Sql" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" exampleText="public static void"/>
  <Color name="Control" exampleText="if (x) return;"/>
  <Color name="Type" exampleText="int string"/>
  <Color name="Function" exampleText="Foo(bar)"/>
  <Color name="Variable" exampleText="$value"/>
  <Color name="Property" exampleText="obj.Name"/>
  <Color name="String" exampleText="&quot;text&quot;"/>
  <Color name="Number" exampleText="0xFF 3.14"/>
  <Color name="Constant" exampleText="true null"/>
  <Color name="Comment" exampleText="// comment"/>
  <Color name="Operator" exampleText="+ - =&gt;"/>
  <Color name="Punctuation" exampleText="{ } ( ) ;"/>
  <Color name="Escape" exampleText="\n \t"/>
  <Color name="Directive" exampleText=".text"/>
  <Color name="Link" exampleText="[text](url)"/>

  <RuleSet ignoreCase="true">
    <Span color="Comment" ruleSet="Cmt" begin="--"/>
    <Span color="Comment" multiline="true" ruleSet="Cmt" begin="/\*" end="\*/"/>
    <Span color="String" multiline="true" begin="\$\$" end="\$\$"/>
    <Span color="String" multiline="true" ruleSet="SqSq" begin="(?:(?&lt;!\w)[NnEeXxBb])?'" end="'(?!')"/>
    <Span color="Variable" ruleSet="SqDq" begin="&quot;" end="&quot;(?!&quot;)"/>
    <Span color="Variable" begin="`" end="`"/>
    <Rule color="Variable">\[[A-Za-z_][^\]\n]*\]</Rule>
    <Rule color="Variable">@@?[A-Za-z_#][\w]*|(?&lt;![:\w]):[A-Za-z_]\w*|\$\d+</Rule>
    <Rule color="Control">(?i:(?&lt;![\w.])(?:
      exception|continue|rollback|iterate|returns|commit|elseif|repeat|return|begin|break|catch|leave|
      raise|throw|until|while|case|else|goto|loop|then|when|end|try|if
    )\b)</Rule>
    <Rule color="Keyword">(?i:(?&lt;![\w.])(?:
      auto_increment|autoincrement|begin_atomic|materialized|nonclustered|referencing|tablesample|
      transaction|constraint|references|tablespace|clustered|following|intersect|partition|preceding|
      procedure|recursive|returning|savepoint|statement|temporary|unbounded|database|describe|distinct|
      function|grouping|identity|restrict|sequence|truncate|unsigned|zerofill|analyze|between|cascade|
      charset|collate|comment|current|declare|default|execute|explain|foreign|instead|lateral|natural|
      nocheck|primary|replace|similar|trigger|unpivot|before|column|create|delete|engine|escape|except|
      exists|filter|having|insert|offset|output|pragma|rename|revoke|rollup|schema|select|unique|unlock|
      update|vacuum|values|window|within|after|alter|check|cross|fetch|first|grant|group|ilike|index|
      inner|limit|merge|minus|nulls|order|outer|owner|pivot|range|right|start|table|union|using|where|
      cast|cube|desc|drop|each|exec|from|full|into|join|last|left|like|lock|next|only|over|role|rows|sets|
      show|some|temp|user|view|with|add|all|and|any|asc|for|key|new|not|old|row|set|top|use|as|by|go|in|
      is|of|on|or|to
    )\b)</Rule>
    <Rule color="Type">(?i:(?&lt;![\w.])(?:
      uniqueidentifier|smalldatetime|hierarchyid|smallserial|sql_variant|timestamptz|mediumblob|
      mediumtext|rowversion|smallmoney|bigserial|datetime2|geography|mediumint|precision|timestamp|
      varbinary|datetime|geometry|interval|longblob|longtext|nvarchar|regclass|smallint|tinyblob|tinytext|
      boolean|decimal|integer|macaddr|numeric|tinyint|varchar|bigint|binary|double|serial|array|bytea|
      float|image|jsonb|money|nchar|ntext|blob|bool|char|cidr|clob|date|enum|inet|json|real|text|time|
      uuid|year|bit|int|oid|xml
    )\b)</Rule>
    <Rule color="Constant">(?i:(?&lt;![\w.])(?:unknown|false|null|true)\b)</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F]+\b</Rule>
    <Rule color="Number">(?&lt;![\w.])(?:\d+\.?\d*|\.\d+)(?:[eE][+-]?\d+)?\b</Rule>
    <Rule color="Function">(?i:(?&lt;![\w.])(?:current_timestamp|localtimestamp|current_date|current_time|current_user|session_user|localtime)\b)</Rule>
    <Rule color="Function">(?&lt;!\b(?i:into|table|from|join|update|view|index|on|exists|references|truncate)\s+)\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*\b</Rule>
    <Rule color="Operator">::|\|\||&lt;&gt;|!=|[-+*/%=&lt;&gt;!&amp;|^~]+</Rule>
    <Rule color="Punctuation">[{}()\[\];,.:]</Rule>
  </RuleSet>

  <RuleSet name="Esc" ignoreCase="true">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="Cmt" ignoreCase="true">
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="Doc" ignoreCase="true">
    <Rule color="Directive">(?&lt;![\w])[@\\][A-Za-z]+</Rule>
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="SqSq" ignoreCase="true">
    <Span color="Escape" begin="''" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="SqDq" ignoreCase="true">
    <Span color="Escape" begin="&quot;&quot;" end="(?=.)"/>
  </RuleSet>
</SyntaxDefinition>

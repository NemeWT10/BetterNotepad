<?xml version="1.0" encoding="utf-8"?>
<!-- BetterNotepad syntax definition: FSharp. Colors are SyntaxToken names; the active theme paints them. -->
<SyntaxDefinition name="FSharp" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" exampleText="public static void"/>
  <Color name="Control" exampleText="if (x) return;"/>
  <Color name="Type" exampleText="int string"/>
  <Color name="Function" exampleText="Foo(bar)"/>
  <Color name="Variable" exampleText="$value"/>
  <Color name="Property" exampleText="obj.Name"/>
  <Color name="String" exampleText="&quot;text&quot;"/>
  <Color name="Number" exampleText="0xFF 3.14"/>
  <Color name="Constant" exampleText="true null"/>
  <Color name="Comment" exampleText="// comment"/>
  <Color name="DocComment" exampleText="/// summary"/>
  <Color name="Preprocessor" exampleText="#include"/>
  <Color name="Operator" exampleText="+ - =&gt;"/>
  <Color name="Punctuation" exampleText="{ } ( ) ;"/>
  <Color name="Attribute" exampleText="[Serializable]"/>
  <Color name="Escape" exampleText="\n \t"/>
  <Color name="Directive" exampleText=".text"/>
  <Color name="Link" exampleText="[text](url)"/>

  <RuleSet>
    <Span color="DocComment" ruleSet="Doc" begin="///"/>
    <Span color="Comment" ruleSet="Cmt" begin="//"/>
    <Span color="Comment" multiline="true" ruleSet="Cmt" begin="\(\*(?!\))" end="\*\)"/>
    <Span color="String" multiline="true" ruleSet="FsInterpVerb" begin="\$@&quot;|@\$&quot;" end="&quot;(?!&quot;)"/>
    <Span color="String" multiline="true" ruleSet="FsVerb" begin="@&quot;" end="&quot;(?!&quot;)"/>
    <Span color="String" multiline="true" ruleSet="FsInterpVerb" begin="\$&quot;&quot;&quot;" end="&quot;&quot;&quot;"/>
    <Span color="String" multiline="true" begin="&quot;&quot;&quot;" end="&quot;&quot;&quot;"/>
    <Span color="String" multiline="true" ruleSet="FsInterp" begin="\$&quot;" end="&quot;"/>
    <Span color="String" multiline="true" ruleSet="Esc" begin="&quot;(?!&quot;&quot;)" end="&quot;"/>
    <Rule color="String">'(?:\\(?:u[0-9A-Fa-f]{4}|x[0-9A-Fa-f]{2}|\d{3}|.)|[^\\'\n])'</Rule>
    <Span color="Attribute" begin="\[&lt;" end="&gt;\]"/>
    <Rule color="Preprocessor">^\s*\#\s*(?:if|else|endif|nowarn|warnon|load|r|I|light|line)\b</Rule>
    <Rule color="Keyword">\b(?:let|use|do|match|return|yield)!</Rule>
    <Rule color="Keyword">\b(?:async|seq|task|query|lazy|backgroundTask)(?=\s*\{)</Rule>
    <Rule color="Function">(?&lt;![\w.])(?:
      invalidArg|failwithf|invalidOp|eprintfn|failwith|eprintf|printfn|reraise|sprintf|ignore|printf|
      raise|unbox|box|fst|snd
    )\b</Rule>
    <Rule color="Control">(?&lt;![\w.])(?:
      finally|assert|downto|return|match|raise|while|yield|done|elif|else|then|when|with|for|try|do|if|in|
      to
    )\b</Rule>
    <Rule color="Keyword">(?&lt;![\w.])(?:
      exception|interface|namespace|abstract|delegate|downcast|function|internal|override|default|inherit|
      mutable|private|extern|global|inline|member|module|public|select|static|struct|upcast|begin|class|
      fixed|base|lazy|open|type|void|and|end|fun|let|new|not|rec|sig|use|val|as|of|or
    )\b</Rule>
    <Rule color="Constant">(?&lt;![\w.])(?:false|None|null|true)\b</Rule>
    <Rule color="Type">(?&lt;![\w.])(?:
      unativeint|nativeint|decimal|float32|voption|bigint|double|option|single|string|uint16|uint32|
      uint64|array|float|int16|int32|int64|sbyte|uint8|bool|byte|char|int8|list|uint|unit|exn|int|obj|ref|
      seq
    )\b</Rule>
    <Rule color="Type">'[A-Za-z_]\w*\b|\^[A-Za-z_]\w*\b</Rule>
    <Rule color="Function">(?&lt;=\b(?:let|member|and)\s+(?:(?:inline|rec|private|public|internal|mutable|static|override|default)\s+)*)(?:[A-Za-z_]\w*\.)?[a-z_]\w*(?=\s+[\w(_'\[{]|\s*\()</Rule>
    <Rule color="Function">(?&lt;=\|&gt;\s*(?:[A-Z]\w*\.)*)[a-z_]\w*</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F_]+(?:[uU][yYsSlLnN]?|[yYsSlLnNI])?\b</Rule>
    <Rule color="Number">\b0[bB][01_]+(?:[uU][yYsSlLnN]?|[yYsSlLnNI])?\b</Rule>
    <Rule color="Number">\b0[oO][0-7_]+(?:[uU][yYsSlLnN]?|[yYsSlLnNI])?\b</Rule>
    <Rule color="Number">(?&lt;![\w.])(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?(?:[uU][yYsSlLnN]?|[yYsSlLnNfFmMI])?\b</Rule>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Constant">\b[A-Z][A-Z0-9_]{2,}\b</Rule>
    <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*\b</Rule>
    <Rule color="Type">\b[A-Z]\w*\b</Rule>
    <Rule color="Operator">[-+*/%=&lt;&gt;!&amp;|^~?@$:]+|\.\.</Rule>
    <Rule color="Punctuation">[{}()\[\];,.]</Rule>
  </RuleSet>

  <RuleSet name="Esc">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="Cmt">
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="Doc">
    <Rule color="Directive">(?&lt;![\w])[@\\][A-Za-z]+</Rule>
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="FsVerb">
    <Span color="Escape" begin="&quot;&quot;" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="FsInterp">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
    <Span color="Escape" begin="\{\{|\}\}" end="(?=.)"/>
    <Span color="Variable">
      <Begin color="Punctuation">\{(?!\{)</Begin>
      <End color="Punctuation">\}</End>
      <RuleSet>
        <Rule color="Constant">\b(?:true|false|null)\b</Rule>
        <Rule color="Number">\b0[xX][0-9a-fA-F_]+(?:[uU][yYsSlLnN]?|[yYsSlLnNI])?\b</Rule>
        <Rule color="Number">\b0[bB][01_]+(?:[uU][yYsSlLnN]?|[yYsSlLnNI])?\b</Rule>
        <Rule color="Number">\b0[oO][0-7_]+(?:[uU][yYsSlLnN]?|[yYsSlLnNI])?\b</Rule>
        <Rule color="Number">(?&lt;![\w.])(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?(?:[uU][yYsSlLnN]?|[yYsSlLnNfFmMI])?\b</Rule>
        <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
        <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*\b</Rule>
        <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
      </RuleSet>
    </Span>
  </RuleSet>

  <RuleSet name="FsInterpVerb">
    <Span color="Escape" begin="&quot;&quot;" end="(?=.)"/>
    <Span color="Escape" begin="\{\{|\}\}" end="(?=.)"/>
    <Span color="Variable">
      <Begin color="Punctuation">\{(?!\{)</Begin>
      <End color="Punctuation">\}</End>
      <RuleSet>
        <Rule color="Constant">\b(?:true|false|null)\b</Rule>
        <Rule color="Number">\b0[xX][0-9a-fA-F_]+(?:[uU][yYsSlLnN]?|[yYsSlLnNI])?\b</Rule>
        <Rule color="Number">\b0[bB][01_]+(?:[uU][yYsSlLnN]?|[yYsSlLnNI])?\b</Rule>
        <Rule color="Number">\b0[oO][0-7_]+(?:[uU][yYsSlLnN]?|[yYsSlLnNI])?\b</Rule>
        <Rule color="Number">(?&lt;![\w.])(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?(?:[uU][yYsSlLnN]?|[yYsSlLnNfFmMI])?\b</Rule>
        <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
        <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*\b</Rule>
        <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
      </RuleSet>
    </Span>
  </RuleSet>
</SyntaxDefinition>

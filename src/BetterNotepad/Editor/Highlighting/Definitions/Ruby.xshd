<?xml version="1.0" encoding="utf-8"?>
<!-- BetterNotepad syntax definition: Ruby. Colors are SyntaxToken names; the active theme paints them. -->
<SyntaxDefinition name="Ruby" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" exampleText="public static void"/>
  <Color name="Control" exampleText="if (x) return;"/>
  <Color name="Type" exampleText="int string"/>
  <Color name="Function" exampleText="Foo(bar)"/>
  <Color name="Variable" exampleText="$value"/>
  <Color name="Property" exampleText="obj.Name"/>
  <Color name="String" exampleText="&quot;text&quot;"/>
  <Color name="Number" exampleText="0xFF 3.14"/>
  <Color name="Constant" exampleText="true null"/>
  <Color name="Comment" exampleText="// comment"/>
  <Color name="Operator" exampleText="+ - =&gt;"/>
  <Color name="Punctuation" exampleText="{ } ( ) ;"/>
  <Color name="Escape" exampleText="\n \t"/>
  <Color name="Regex" exampleText="/[a-z]+/g"/>
  <Color name="Directive" exampleText=".text"/>
  <Color name="Link" exampleText="[text](url)"/>

  <RuleSet>
    <Span color="Comment" multiline="true" begin="^=begin\b" end="^=end\b"/>
    <Span color="Comment" ruleSet="Cmt" begin="\#"/>
    <Span color="String" ruleSet="RbDq" begin="&quot;" end="&quot;"/>
    <Span color="String" ruleSet="RbSq" begin="'" end="'"/>
    <Span color="String" ruleSet="RbDq" begin="`" end="`"/>
    <Span color="String" multiline="true" ruleSet="RbQ" begin="(?&lt;![\w)\]}])%[wWiIqQsx]?\[" end="\]"/>
    <Span color="String" multiline="true" ruleSet="RbQ" begin="(?&lt;![\w)\]}])%[wWiIqQsx]?\(" end="\)"/>
    <Span color="String" multiline="true" ruleSet="RbQ" begin="(?&lt;![\w)\]}])%[wWiIqQsx]?\{" end="\}"/>
    <Span color="String" multiline="true" ruleSet="RbQ" begin="(?&lt;![\w)\]}])%[wWiIqQsx]?&lt;" end="&gt;"/>
    <Rule color="Regex">(?&lt;=(?:^|[=(:,\[!&amp;|?{};+\-*%&lt;&gt;~^])\s*|\b(?:if|unless|when|and|or|not|return|split|scan|match|gsub|sub|while)\s+)/(?![/*\s=])(?:\\.|\[(?:\\.|[^\]\\\n])*\]|[^/\\\n\[])+/[imxounse]*</Rule>
    <Rule color="Variable">@@?[A-Za-z_]\w*|\$[A-Za-z_]\w*|\$[0-9~*$?!@/\\;,.=:&lt;&gt;\"&amp;`'+]</Rule>
    <Rule color="Constant">(?&lt;![:\w]):(?:[A-Za-z_]\w*[?!=]?|[-+*/&lt;&gt;=!~%^&amp;|]+)</Rule>
    <Rule color="Property">\b[A-Za-z_]\w*[?!]?(?=:(?!:))</Rule>
    <Rule color="Function">(?&lt;=\bdef\s+)(?:self\.)?[A-Za-z_]\w*[?!=]?</Rule>
    <Rule color="Type">(?&lt;=\b(?:class|module)\s+)[A-Za-z_][\w:]*</Rule>
    <Rule color="Control">(?&lt;![\w.])(?:ensure|rescue|return|unless|break|elsif|retry|until|while|case|else|next|redo|then|when|for|if)\b</Rule>
    <Rule color="Keyword">(?&lt;![\w.])(?:
      module_function|__method__|protected|__FILE__|__LINE__|defined\?|private|module|public|BEGIN|alias|
      begin|class|super|undef|yield|self|END|and|def|end|not|do|in|or
    )(?![\w])</Rule>
    <Rule color="Constant">(?&lt;![\w.])(?:false|true|nil)\b</Rule>
    <Rule color="Function">(?&lt;![\w.])(?:
      require_relative|attr_accessor|attr_reader|attr_writer|include|prepend|require|extend|format|freeze|
      lambda|printf|catch|print|raise|sleep|throw|fail|gets|load|loop|proc|puts|pp|p
    )\b</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F_]+[rRiI]?\b</Rule>
    <Rule color="Number">\b0[bB][01_]+[rRiI]?\b</Rule>
    <Rule color="Number">\b0[oO][0-7_]+[rRiI]?\b</Rule>
    <Rule color="Number">(?:(?&lt;![\w.])|(?&lt;=\.\.))(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?[rRiI]?\b</Rule>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Constant">\b[A-Z][A-Z0-9_]{2,}\b</Rule>
    <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*\b</Rule>
    <Rule color="Type">\b[A-Z]\w*\b</Rule>
    <Rule color="Operator">&lt;=&gt;|=~|!~|\.\.\.?|&amp;\.|[-+*/%=&lt;&gt;!&amp;|^~?]+</Rule>
    <Rule color="Punctuation">[{}()\[\];,.:]</Rule>
  </RuleSet>

  <RuleSet name="Esc">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="Cmt">
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="Doc">
    <Rule color="Directive">(?&lt;![\w])[@\\][A-Za-z]+</Rule>
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="RbDq">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
    <Span color="Variable">
      <Begin color="Punctuation">\#\{</Begin>
      <End color="Punctuation">\}</End>
      <RuleSet>
        <Span color="String" ruleSet="RbDq" begin="&quot;" end="&quot;"/>
        <Span color="String" ruleSet="RbSq" begin="'" end="'"/>
        <Rule color="Constant">(?&lt;![\w.])(?:false|true|nil)\b</Rule>
        <Rule color="Keyword">(?&lt;![\w.])(?:unless|self|and|not|if|or)\b</Rule>
        <Rule color="Constant">(?&lt;![:\w]):[A-Za-z_]\w*</Rule>
        <Rule color="Number">\b0[xX][0-9a-fA-F_]+[rRiI]?\b</Rule>
        <Rule color="Number">\b0[bB][01_]+[rRiI]?\b</Rule>
        <Rule color="Number">\b0[oO][0-7_]+[rRiI]?\b</Rule>
        <Rule color="Number">(?&lt;![\w.])(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?[rRiI]?\b</Rule>
        <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
        <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*[?!]?</Rule>
        <Rule color="Constant">\b[A-Z][A-Z0-9_]{2,}\b</Rule>
        <Rule color="Type">\b[A-Z]\w*\b</Rule>
        <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
        <Rule color="Punctuation">[()\[\],.]+</Rule>
      </RuleSet>
    </Span>
  </RuleSet>

  <RuleSet name="RbSq">
    <Span color="Escape" begin="\\['\\]" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="RbQ">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
  </RuleSet>
</SyntaxDefinition>

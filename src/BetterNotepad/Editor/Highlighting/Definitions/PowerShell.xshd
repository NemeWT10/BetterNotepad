<?xml version="1.0" encoding="utf-8"?>
<!-- BetterNotepad syntax definition: PowerShell. Colors are SyntaxToken names; the active theme paints them. -->
<SyntaxDefinition name="PowerShell" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" exampleText="public static void"/>
  <Color name="Control" exampleText="if (x) return;"/>
  <Color name="Type" exampleText="int string"/>
  <Color name="Function" exampleText="Foo(bar)"/>
  <Color name="Variable" exampleText="$value"/>
  <Color name="Property" exampleText="obj.Name"/>
  <Color name="String" exampleText="&quot;text&quot;"/>
  <Color name="Number" exampleText="0xFF 3.14"/>
  <Color name="Constant" exampleText="true null"/>
  <Color name="Comment" exampleText="// comment"/>
  <Color name="Operator" exampleText="+ - =&gt;"/>
  <Color name="Punctuation" exampleText="{ } ( ) ;"/>
  <Color name="Attribute" exampleText="[Serializable]"/>
  <Color name="Escape" exampleText="\n \t"/>
  <Color name="Directive" exampleText=".text"/>
  <Color name="Link" exampleText="[text](url)"/>

  <RuleSet ignoreCase="true">
    <Span color="Comment" multiline="true" ruleSet="PsDoc" begin="&lt;\#" end="\#&gt;"/>
    <Span color="Comment" ruleSet="Cmt" begin="\#"/>
    <Span color="String" multiline="true" ruleSet="PsHere" begin="@&quot;\s*$" end="^&quot;@"/>
    <Span color="String" multiline="true" begin="@'\s*$" end="^'@"/>
    <Span color="String" multiline="true" ruleSet="PsEsc" begin="&quot;" end="&quot;(?!&quot;)"/>
    <Span color="String" multiline="true" ruleSet="PsSq" begin="'" end="'(?!')"/>
    <Rule color="Constant">(?i:(?&lt;![\w$])(?:\$false|\$null|\$true)\b)</Rule>
    <Rule color="Variable">\$(?:\{[^}\n]*\}|(?:(?:global|script|local|private|env|using):)?[A-Za-z_?^$][\w]*)</Rule>
    <Rule color="Variable">@[A-Za-z_]\w*</Rule>
    <Rule color="Control">(?i:(?&lt;![\w$.-])(?:
      continue|finally|foreach|elseif|return|switch|break|catch|throw|until|while|else|exit|trap|for|try|
      do|if
    )\b)</Rule>
    <Rule color="Keyword">(?i:(?&lt;![\w$.-])(?:
      dynamicparam|namespace|function|workflow|process|filter|hidden|module|static|begin|class|param|
      using|data|enum|end|in
    )\b)</Rule>
    <Rule color="Operator">(?i:(?&lt;=\s)-(?:
      notcontains|contains|creplace|notmatch|notlike|replace|cmatch|clike|isnot|match|notin|split|band|
      bnot|bxor|join|like|and|bor|ceq|cge|cgt|cle|clt|cne|not|shl|shr|xor|as|eq|ge|gt|in|is|le|lt|ne|or|f
    )\b)</Rule>
    <Rule color="Attribute">\[(?:CmdletBinding|Parameter|Alias|OutputType|Validate\w+|Allow\w+|SupportsWildcards)\b(?:\([^)\n]*\))?\]</Rule>
    <Rule color="Type">\[[A-Za-z_][\w.]*(?:\[\])?\]</Rule>
    <Rule color="Function">(?i:\b(?:Get|Set|New|Remove|Add|Clear|Copy|Move|Rename|Invoke|Start|Stop|Restart|Write|Read|Out|Select|Where|ForEach|Sort|Group|Measure|Test|Import|Export|ConvertTo|ConvertFrom|Format|Enter|Exit|Join|Split|Resolve|Push|Pop|Wait|Register|Unregister|Enable|Disable|Install|Uninstall|Update|Find|Show|Hide|Lock|Unlock|Send|Receive|Compare|Debug|Trace|Limit|Tee|Use|Expand|Confirm|Grant|Revoke|Backup|Restore|Mount|Dismount|Publish|Unpublish|Save|Edit|Protect|Unprotect|Submit|Suspend|Resume|Complete|Approve|Deny|Block|Unblock|Optimize|Repair|Reset|Initialize|Checkpoint|Switch|Step|Sync|Build|Assert|Close|Open|Ping|Skip|Disconnect|Connect|Merge|Convert|Rollback|Redo|Undo|Search|Watch)-[A-Za-z][\w]*\b)</Rule>
    <Rule color="Function">(?i:(?&lt;![\w$.-])(?:
      foreach|measure|select|clear|mkdir|rmdir|sleep|where|copy|echo|kill|sort|type|cat|cls|del|dir|gci|
      iex|irm|iwr|man|pwd|ren|rni|sls|tee|cd|cp|gc|gm|gp|ii|ls|md|mv|ni|ps|rd|rm|sl
    )(?![\w.-]))</Rule>
    <Rule color="Attribute">(?&lt;=\s)-[A-Za-z][\w]*</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F]+(?:[kKmMgGtTpP][bB])?[lLdD]?\b</Rule>
    <Rule color="Number">(?&lt;![\w.])(?:\d[\d]*(?:\.(?!\.)[\d]*)?|\.\d[\d]*)(?:[eE][+-]?\d[\d]*)?(?:[kKmMgGtTpP][bB])?[lLdD]?\b</Rule>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Property">(?&lt;=\.|::)[A-Za-z_]\w*\b</Rule>
    <Rule color="Operator">&amp;&amp;|\|\||[-+*/%=&lt;&gt;!&amp;|^~?]+</Rule>
    <Rule color="Punctuation">[{}()\[\];,.:]</Rule>
  </RuleSet>

  <RuleSet name="Esc" ignoreCase="true">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="Cmt" ignoreCase="true">
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="Doc" ignoreCase="true">
    <Rule color="Directive">(?&lt;![\w])[@\\][A-Za-z]+</Rule>
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="PsEsc" ignoreCase="true">
    <Span color="Escape" begin="`." end="(?=.)"/>
    <Span color="Escape" begin="&quot;&quot;" end="(?=.)"/>
    <Span color="Variable" ruleSet="PsCode">
      <Begin color="Punctuation">\$\(</Begin>
      <End color="Punctuation">\)</End>
    </Span>
    <Rule color="Variable">\$(?:\{[^}\n]*\}|(?:(?:global|script|local|private|env|using):)?[A-Za-z_?^$][\w]*)</Rule>
  </RuleSet>

  <RuleSet name="PsSq" ignoreCase="true">
    <Span color="Escape" begin="''" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="PsHere" ignoreCase="true">
    <Span color="Variable" ruleSet="PsCode">
      <Begin color="Punctuation">\$\(</Begin>
      <End color="Punctuation">\)</End>
    </Span>
    <Rule color="Variable">\$(?:\{[^}\n]*\}|(?:(?:global|script|local|private|env|using):)?[A-Za-z_?^$][\w]*)</Rule>
  </RuleSet>

  <RuleSet name="PsDoc" ignoreCase="true">
    <Rule color="Directive">^\s*\.[A-Za-z]+\b</Rule>
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="PsCode" ignoreCase="true">
    <Span color="String" ruleSet="PsEsc" begin="&quot;" end="&quot;(?!&quot;)"/>
    <Span color="String" ruleSet="PsSq" begin="'" end="'(?!')"/>
    <Rule color="Variable">\$(?:\{[^}\n]*\}|(?:(?:global|script|local|private|env|using):)?[A-Za-z_?^$][\w]*)</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F]+\b</Rule>
    <Rule color="Number">(?&lt;![\w.])(?:\d[\d]*(?:\.(?!\.)[\d]*)?|\.\d[\d]*)(?:[eE][+-]?\d[\d]*)?\b</Rule>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Property">(?&lt;=\.)\w+</Rule>
    <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
    <Rule color="Punctuation">[()\[\],.]+</Rule>
  </RuleSet>
</SyntaxDefinition>

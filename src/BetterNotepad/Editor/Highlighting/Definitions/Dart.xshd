<?xml version="1.0" encoding="utf-8"?>
<!-- BetterNotepad syntax definition: Dart. Colors are SyntaxToken names; the active theme paints them. -->
<SyntaxDefinition name="Dart" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" exampleText="public static void"/>
  <Color name="Control" exampleText="if (x) return;"/>
  <Color name="Type" exampleText="int string"/>
  <Color name="Function" exampleText="Foo(bar)"/>
  <Color name="Variable" exampleText="$value"/>
  <Color name="Property" exampleText="obj.Name"/>
  <Color name="String" exampleText="&quot;text&quot;"/>
  <Color name="Number" exampleText="0xFF 3.14"/>
  <Color name="Constant" exampleText="true null"/>
  <Color name="Comment" exampleText="// comment"/>
  <Color name="DocComment" exampleText="/// summary"/>
  <Color name="Operator" exampleText="+ - =&gt;"/>
  <Color name="Punctuation" exampleText="{ } ( ) ;"/>
  <Color name="Attribute" exampleText="[Serializable]"/>
  <Color name="Escape" exampleText="\n \t"/>
  <Color name="Directive" exampleText=".text"/>
  <Color name="Link" exampleText="[text](url)"/>

  <RuleSet>
    <Span color="DocComment" multiline="true" ruleSet="Doc" begin="/\*[*!](?![*/])" end="\*/"/>
    <Span color="DocComment" ruleSet="Doc" begin="///(?!/)"/>
    <Span color="Comment" multiline="true" ruleSet="Cmt" begin="/\*(?![*!](?![*/]))" end="\*/"/>
    <Span color="Comment" ruleSet="Cmt" begin="//(?!/(?!/))"/>
    <Span color="String" multiline="true" begin="\br'''" end="'''"/>
    <Span color="String" multiline="true" begin="\br&quot;&quot;&quot;" end="&quot;&quot;&quot;"/>
    <Span color="String" begin="\br'" end="'"/>
    <Span color="String" begin="\br&quot;" end="&quot;"/>
    <Span color="String" multiline="true" ruleSet="DtEsc" begin="'''" end="'''"/>
    <Span color="String" multiline="true" ruleSet="DtEsc" begin="&quot;&quot;&quot;" end="&quot;&quot;&quot;"/>
    <Span color="String" ruleSet="DtEsc" begin="'(?!'')" end="'"/>
    <Span color="String" ruleSet="DtEsc" begin="&quot;(?!&quot;&quot;)" end="&quot;"/>
    <Rule color="Attribute">@[A-Za-z_]\w*(?:\.[A-Za-z_]\w*)?</Rule>
    <Rule color="Control">(?&lt;![\w.])(?:
      continue|default|finally|rethrow|assert|return|switch|await|break|catch|throw|while|yield|case|else|
      when|for|try|do|if
    )\b</Rule>
    <Rule color="Keyword">(?&lt;![\w.])(?:
      implements|covariant|extension|interface|Function|abstract|deferred|external|operator|required|
      dynamic|extends|factory|library|typedef|export|import|sealed|static|async|class|const|final|mixin|
      super|base|enum|hide|late|part|show|sync|this|void|with|get|new|set|var|as|in|is|on
    )\b</Rule>
    <Rule color="Constant">(?&lt;![\w.])(?:false|null|true)\b</Rule>
    <Rule color="Type">(?&lt;![\w.])(?:dynamic|double|Never|bool|int|num)\b</Rule>
    <Rule color="Type">(?&lt;=\b(?:class|mixin|enum|extension|typedef|extends|implements|with|on)\s+)[A-Za-z_]\w*</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F_]+\b</Rule>
    <Rule color="Number">(?&lt;![\w.])(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?\b</Rule>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Property">(?&lt;=[{(,;]\s*|^\s*)[A-Za-z_]\w*(?=\s*\??:(?![:=]))</Rule>
    <Rule color="Constant">\b[A-Z][A-Z0-9_]{2,}\b</Rule>
    <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*\b</Rule>
    <Rule color="Type">\b[A-Z]\w*\b</Rule>
    <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
    <Rule color="Punctuation">[{}()\[\];,.:]</Rule>
  </RuleSet>

  <RuleSet name="Esc">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="Cmt">
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="Doc">
    <Rule color="Directive">(?&lt;![\w])[@\\][A-Za-z]+</Rule>
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="DtEsc">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
    <Rule color="Variable">\$[A-Za-z_]\w*</Rule>
    <Span color="Variable">
      <Begin color="Punctuation">\$\{</Begin>
      <End color="Punctuation">\}</End>
      <RuleSet>
        <Span color="String" ruleSet="DtEsc" begin="&quot;" end="&quot;"/>
        <Span color="String" ruleSet="DtEsc" begin="'" end="'"/>
        <Rule color="Keyword">(?&lt;![\w.])(?:await|super|this|new|as|is)\b</Rule>
        <Rule color="Constant">(?&lt;![\w.])(?:false|null|true)\b</Rule>
        <Rule color="Number">\b0[xX][0-9a-fA-F_]+\b</Rule>
        <Rule color="Number">\b0[bB][01_]+\b</Rule>
        <Rule color="Number">\b0[oO][0-7_]+\b</Rule>
        <Rule color="Number">(?&lt;![\w.])(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?\b</Rule>
        <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
        <Rule color="Property">(?&lt;=[{(,;]\s*|^\s*)[A-Za-z_]\w*(?=\s*\??:(?![:=]))</Rule>
        <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*\b</Rule>
        <Rule color="Type">\b[A-Z]\w*\b</Rule>
        <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
        <Rule color="Punctuation">[()\[\],.]+</Rule>
      </RuleSet>
    </Span>
  </RuleSet>

  <RuleSet name="DtRaw">
    <Rule color="Variable">\$[A-Za-z_]\w*</Rule>
    <Span color="Variable">
      <Begin color="Punctuation">\$\{</Begin>
      <End color="Punctuation">\}</End>
      <RuleSet>
        <Span color="String" ruleSet="DtEsc" begin="&quot;" end="&quot;"/>
        <Span color="String" ruleSet="DtEsc" begin="'" end="'"/>
        <Rule color="Keyword">(?&lt;![\w.])(?:await|super|this|new|as|is)\b</Rule>
        <Rule color="Constant">(?&lt;![\w.])(?:false|null|true)\b</Rule>
        <Rule color="Number">\b0[xX][0-9a-fA-F_]+\b</Rule>
        <Rule color="Number">\b0[bB][01_]+\b</Rule>
        <Rule color="Number">\b0[oO][0-7_]+\b</Rule>
        <Rule color="Number">(?&lt;![\w.])(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?\b</Rule>
        <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
        <Rule color="Property">(?&lt;=[{(,;]\s*|^\s*)[A-Za-z_]\w*(?=\s*\??:(?![:=]))</Rule>
        <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*\b</Rule>
        <Rule color="Type">\b[A-Z]\w*\b</Rule>
        <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
        <Rule color="Punctuation">[()\[\],.]+</Rule>
      </RuleSet>
    </Span>
  </RuleSet>
</SyntaxDefinition>

<?xml version="1.0" encoding="utf-8"?>
<!-- BetterNotepad syntax definition: CSharp. Colors are SyntaxToken names; the active theme paints them. -->
<SyntaxDefinition name="CSharp" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" exampleText="public static void"/>
  <Color name="Control" exampleText="if (x) return;"/>
  <Color name="Type" exampleText="int string"/>
  <Color name="Function" exampleText="Foo(bar)"/>
  <Color name="Variable" exampleText="$value"/>
  <Color name="Property" exampleText="obj.Name"/>
  <Color name="String" exampleText="&quot;text&quot;"/>
  <Color name="Number" exampleText="0xFF 3.14"/>
  <Color name="Constant" exampleText="true null"/>
  <Color name="Comment" exampleText="// comment"/>
  <Color name="DocComment" exampleText="/// summary"/>
  <Color name="Preprocessor" exampleText="#include"/>
  <Color name="Operator" exampleText="+ - =&gt;"/>
  <Color name="Punctuation" exampleText="{ } ( ) ;"/>
  <Color name="Attribute" exampleText="[Serializable]"/>
  <Color name="Tag" exampleText="&lt;div&gt;"/>
  <Color name="AttrName" exampleText="class"/>
  <Color name="Escape" exampleText="\n \t"/>
  <Color name="Directive" exampleText=".text"/>
  <Color name="Link" exampleText="[text](url)"/>

  <RuleSet>
    <Span color="DocComment" ruleSet="Xml" begin="///(?!/)"/>
    <Span color="DocComment" multiline="true" ruleSet="Xml" begin="/\*\*(?![*/])" end="\*/"/>
    <Span color="Comment" multiline="true" ruleSet="Cmt" begin="/\*(?!\*(?![*/]))" end="\*/"/>
    <Span color="Comment" ruleSet="Cmt" begin="//(?!/(?!/))"/>
    <Span color="Preprocessor" begin="^\s*\#\s*(?:if|elif|else|endif|define|undef|warning|error|line|region|endregion|pragma|nullable)\b"/>
    <Span color="String" multiline="true" begin="\$*&quot;&quot;&quot;+" end="&quot;&quot;&quot;+"/>
    <Span color="String" multiline="true" ruleSet="InterpVerb" begin="(?:\$@|@\$)&quot;" end="&quot;(?!&quot;)"/>
    <Span color="String" multiline="true" ruleSet="Verb" begin="@&quot;" end="&quot;(?!&quot;)"/>
    <Span color="String" ruleSet="Interp" begin="\$&quot;" end="&quot;"/>
    <Span color="String" ruleSet="Esc" begin="&quot;(?!&quot;&quot;)" end="&quot;"/>
    <Span color="String" ruleSet="Esc" begin="'" end="'"/>
    <Span color="Attribute">
      <Begin>(?:^\s*|(?&lt;=[(,]\s*))\[(?=\s*(?:assembly|module|return|field|property|type|method|param|event)?\s*:?\s*[A-Za-z_])</Begin>
      <End>\]</End>
      <RuleSet>
        <Span color="String" ruleSet="Esc" begin="&quot;" end="&quot;"/>
        <Rule color="Number">\b0[xX][0-9a-fA-F_]+(?:[uU]?[lL]?|[lL][uU])\b</Rule>
        <Rule color="Number">\b0[bB][01_]+(?:[uU]?[lL]?|[lL][uU])\b</Rule>
        <Rule color="Number">\b0[oO][0-7_]+(?:[uU]?[lL]?|[lL][uU])\b</Rule>
        <Rule color="Number">(?&lt;![\w.])(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?(?:[uU]?[lL]?|[lL][uU]|[fFdDmM])\b</Rule>
      </RuleSet>
    </Span>
    <Rule color="Control">(?&lt;![\w.@])(?:
      continue|default|finally|foreach|return|switch|break|catch|throw|while|yield|case|else|goto|when|
      for|try|do|if
    )\b</Rule>
    <Rule color="Keyword">(?&lt;![\w.@])(?:
      descending|stackalloc|ascending|interface|namespace|protected|unchecked|abstract|delegate|explicit|
      implicit|internal|operator|override|readonly|required|volatile|checked|orderby|partial|private|
      virtual|extern|global|nameof|params|public|sealed|select|sizeof|static|struct|typeof|unsafe|async|
      await|class|const|event|fixed|using|base|enum|lock|this|with|and|new|not|out|ref|var|as|in|is|or
    )\b</Rule>
    <Rule color="Keyword">(?&lt;![\w.@])(?:get|set|init|add|remove)\b(?=\s*(?:[;{]|=&gt;))</Rule>
    <Rule color="Keyword">(?&lt;![\w.@])from\b(?=\s+\w+\s+in\b)</Rule>
    <Rule color="Keyword">(?&lt;![\w.@])where\b(?=\s+[A-Z]\w*\s*:)</Rule>
    <Rule color="Keyword">(?&lt;![\w.@])record\b(?=\s+(?:class|struct|[A-Za-z_]\w*\s*[(&lt;{;]))</Rule>
    <Rule color="Type">(?&lt;![\w.@])(?:
      decimal|dynamic|double|object|string|ushort|float|nuint|sbyte|short|ulong|bool|byte|char|long|nint|
      uint|void|int
    )\b</Rule>
    <Rule color="Constant">(?&lt;![\w.@])(?:false|null|true)\b</Rule>
    <Rule color="Type">(?&lt;=\b(?:new|class|struct|interface|enum|record|namespace|typeof|is|as|using)\s+)[A-Za-z_][\w.]*</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F_]+(?:[uU]?[lL]?|[lL][uU])\b</Rule>
    <Rule color="Number">\b0[bB][01_]+(?:[uU]?[lL]?|[lL][uU])\b</Rule>
    <Rule color="Number">\b0[oO][0-7_]+(?:[uU]?[lL]?|[lL][uU])\b</Rule>
    <Rule color="Number">(?&lt;![\w.])(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?(?:[uU]?[lL]?|[lL][uU]|[fFdDmM])\b</Rule>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Constant">\b[A-Z][A-Z0-9_]{2,}\b</Rule>
    <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*\b</Rule>
    <Rule color="Type">\b[A-Z]\w*\b</Rule>
    <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
    <Rule color="Punctuation">[{}()\[\];,.:]</Rule>
  </RuleSet>

  <RuleSet name="Esc">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="Cmt">
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="Doc">
    <Rule color="Directive">(?&lt;![\w])[@\\][A-Za-z]+</Rule>
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="Interp">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
    <Span color="Escape" begin="\{\{|\}\}" end="(?=.)"/>
    <Span color="Variable">
      <Begin color="Punctuation">\{(?!\{)</Begin>
      <End color="Punctuation">\}</End>
      <RuleSet>
        <Span color="String" ruleSet="Esc" begin="&quot;" end="&quot;"/>
        <Span color="String" ruleSet="Esc" begin="'" end="'"/>
        <Rule color="Keyword">(?&lt;![\w.@])(?:default|nameof|typeof|await|new|as|is)\b</Rule>
        <Rule color="Constant">(?&lt;![\w.@])(?:false|null|true)\b</Rule>
        <Rule color="Type">(?&lt;![\w.@])(?:
      decimal|dynamic|double|object|string|ushort|float|nuint|sbyte|short|ulong|bool|byte|char|long|nint|
      uint|void|int
    )\b</Rule>
        <Rule color="Number">\b0[xX][0-9a-fA-F_]+(?:[uU]?[lL]?|[lL][uU])\b</Rule>
        <Rule color="Number">\b0[bB][01_]+(?:[uU]?[lL]?|[lL][uU])\b</Rule>
        <Rule color="Number">\b0[oO][0-7_]+(?:[uU]?[lL]?|[lL][uU])\b</Rule>
        <Rule color="Number">(?&lt;![\w.])(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?(?:[uU]?[lL]?|[lL][uU]|[fFdDmM])\b</Rule>
        <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
        <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*\b</Rule>
        <Rule color="Type">\b[A-Z]\w*\b</Rule>
        <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
        <Rule color="Punctuation">[()\[\],.]+</Rule>
      </RuleSet>
    </Span>
  </RuleSet>

  <RuleSet name="InterpVerb">
    <Span color="Escape" begin="&quot;&quot;" end="(?=.)"/>
    <Span color="Escape" begin="\{\{|\}\}" end="(?=.)"/>
    <Span color="Variable">
      <Begin color="Punctuation">\{(?!\{)</Begin>
      <End color="Punctuation">\}</End>
      <RuleSet>
        <Span color="String" ruleSet="Esc" begin="&quot;" end="&quot;"/>
        <Span color="String" ruleSet="Esc" begin="'" end="'"/>
        <Rule color="Keyword">(?&lt;![\w.@])(?:default|nameof|typeof|await|new|as|is)\b</Rule>
        <Rule color="Constant">(?&lt;![\w.@])(?:false|null|true)\b</Rule>
        <Rule color="Type">(?&lt;![\w.@])(?:
      decimal|dynamic|double|object|string|ushort|float|nuint|sbyte|short|ulong|bool|byte|char|long|nint|
      uint|void|int
    )\b</Rule>
        <Rule color="Number">\b0[xX][0-9a-fA-F_]+(?:[uU]?[lL]?|[lL][uU])\b</Rule>
        <Rule color="Number">\b0[bB][01_]+(?:[uU]?[lL]?|[lL][uU])\b</Rule>
        <Rule color="Number">\b0[oO][0-7_]+(?:[uU]?[lL]?|[lL][uU])\b</Rule>
        <Rule color="Number">(?&lt;![\w.])(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?(?:[uU]?[lL]?|[lL][uU]|[fFdDmM])\b</Rule>
        <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
        <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*\b</Rule>
        <Rule color="Type">\b[A-Z]\w*\b</Rule>
        <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
        <Rule color="Punctuation">[()\[\],.]+</Rule>
      </RuleSet>
    </Span>
  </RuleSet>

  <RuleSet name="Verb">
    <Span color="Escape" begin="&quot;&quot;" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="Xml">
    <Rule color="Tag">&lt;/?[A-Za-z][\w:.-]*|/?&gt;</Rule>
    <Rule color="AttrName">\b[A-Za-z_][\w:.-]*(?==)</Rule>
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>
</SyntaxDefinition>

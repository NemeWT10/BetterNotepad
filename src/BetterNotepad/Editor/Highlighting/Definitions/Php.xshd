<?xml version="1.0" encoding="utf-8"?>
<!-- BetterNotepad syntax definition: Php. Colors are SyntaxToken names; the active theme paints them. -->
<SyntaxDefinition name="Php" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" exampleText="public static void"/>
  <Color name="Control" exampleText="if (x) return;"/>
  <Color name="Type" exampleText="int string"/>
  <Color name="Function" exampleText="Foo(bar)"/>
  <Color name="Variable" exampleText="$value"/>
  <Color name="Property" exampleText="obj.Name"/>
  <Color name="String" exampleText="&quot;text&quot;"/>
  <Color name="Number" exampleText="0xFF 3.14"/>
  <Color name="Constant" exampleText="true null"/>
  <Color name="Comment" exampleText="// comment"/>
  <Color name="DocComment" exampleText="/// summary"/>
  <Color name="Preprocessor" exampleText="#include"/>
  <Color name="Operator" exampleText="+ - =&gt;"/>
  <Color name="Punctuation" exampleText="{ } ( ) ;"/>
  <Color name="Attribute" exampleText="[Serializable]"/>
  <Color name="Escape" exampleText="\n \t"/>
  <Color name="Directive" exampleText=".text"/>
  <Color name="Link" exampleText="[text](url)"/>

  <RuleSet>
    <Span multiline="true" ruleSet="PhpCode">
      <Begin color="Preprocessor">&lt;\?(?i:php\b|=)</Begin>
      <End color="Preprocessor">\?&gt;</End>
    </Span>
    <Import ruleSet="Html/"/>
  </RuleSet>

  <RuleSet name="Esc">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="Cmt">
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="Doc">
    <Rule color="Directive">(?&lt;![\w])[@\\][A-Za-z]+</Rule>
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="PhpSq">
    <Span color="Escape" begin="\\['\\]" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="PhpDq">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
    <Span color="Variable" ruleSet="PhpExpr">
      <Begin color="Punctuation">\{(?=\$)</Begin>
      <End color="Punctuation">\}</End>
    </Span>
    <Span color="Variable">
      <Begin color="Punctuation">\$\{</Begin>
      <End color="Punctuation">\}</End>
    </Span>
    <Rule color="Variable">\$[A-Za-z_]\w*(?:-&gt;[A-Za-z_]\w*|\[[^\]\n\"']*\])?</Rule>
  </RuleSet>

  <RuleSet name="PhpExpr">
    <Span color="String" ruleSet="PhpSq" begin="'" end="'"/>
    <Span color="String" ruleSet="PhpDq" begin="&quot;" end="&quot;"/>
    <Rule color="Variable">\$\$?[A-Za-z_]\w*</Rule>
    <Rule color="Constant">(?i:(?&lt;![\w$])(?:
      __NAMESPACE__|__FUNCTION__|PHP_INT_MAX|PHP_VERSION|__METHOD__|__CLASS__|__TRAIT__|__FILE__|__LINE__|
      PHP_EOL|__DIR__|false|null|true
    )\b)</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F_]+\b</Rule>
    <Rule color="Number">\b0[bB][01_]+\b</Rule>
    <Rule color="Number">\b0[oO][0-7_]+\b</Rule>
    <Rule color="Number">(?&lt;![\w.])(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?\b</Rule>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Property">(?&lt;=-&gt;|\?-&gt;|::)\$?[A-Za-z_]\w*</Rule>
    <Rule color="Type">\b[A-Z]\w*\b</Rule>
    <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
    <Rule color="Punctuation">[()\[\],.]+</Rule>
  </RuleSet>

  <RuleSet name="PhpCode">
    <Span color="DocComment" multiline="true" ruleSet="Doc" begin="/\*\*(?![*/])" end="\*/"/>
    <Span color="Comment" multiline="true" ruleSet="Cmt" begin="/\*(?!\*(?![*/]))" end="\*/"/>
    <Span color="Comment" ruleSet="Cmt" begin="//|\#(?!\[)" end="(?=\?&gt;)"/>
    <Span color="Attribute" begin="\#\[" end="\]"/>
    <Span color="String" multiline="true" begin="&lt;&lt;&lt;\s*'[A-Za-z_]\w*'" end="^\s*[A-Z_][A-Z0-9_]*(?=\s*[;,)]|\s*$)"/>
    <Span color="String" multiline="true" ruleSet="PhpDq" begin="&lt;&lt;&lt;\s*&quot;?[A-Za-z_]\w*&quot;?" end="^\s*[A-Z_][A-Z0-9_]*(?=\s*[;,)]|\s*$)"/>
    <Span color="String" ruleSet="PhpSq" begin="'" end="'"/>
    <Span color="String" multiline="true" ruleSet="PhpDq" begin="&quot;" end="&quot;"/>
    <Span color="String" ruleSet="PhpDq" begin="`" end="`"/>
    <Rule color="Variable">\$\$?[A-Za-z_]\w*</Rule>
    <Rule color="Control">(?i:(?&lt;![\w$])(?:
      enddeclare|endforeach|endswitch|continue|endwhile|declare|default|finally|foreach|elseif|endfor|
      return|switch|break|catch|endif|match|throw|while|yield|case|else|goto|for|try|do|if
    )\b)</Rule>
    <Rule color="Keyword">(?i:(?&lt;![\w$])(?:
      __halt_compiler|include_once|require_once|implements|instanceof|insteadof|interface|namespace|
      protected|abstract|callable|function|readonly|extends|include|private|require|global|parent|public|
      static|array|class|clone|const|empty|final|isset|print|trait|unset|echo|enum|eval|exit|list|self|
      and|die|new|use|var|xor|as|fn|or
    )\b)</Rule>
    <Rule color="Constant">(?i:(?&lt;![\w$])(?:
      __NAMESPACE__|__FUNCTION__|PHP_INT_MAX|PHP_VERSION|__METHOD__|__CLASS__|__TRAIT__|__FILE__|__LINE__|
      PHP_EOL|__DIR__|false|null|true
    )\b)</Rule>
    <Rule color="Type">(?i:(?&lt;![\w$])(?:iterable|resource|boolean|integer|double|object|string|float|mixed|never|bool|void|int)\b)</Rule>
    <Rule color="Type">(?&lt;=\b(?i:new|class|extends|implements|instanceof|interface|trait|enum|use|namespace|catch)\s+)\\?[A-Za-z_][\w\\]*</Rule>
    <Rule color="Type">\\[A-Z]\w*(?:\\[A-Z]\w*)*</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F_]+\b</Rule>
    <Rule color="Number">\b0[bB][01_]+\b</Rule>
    <Rule color="Number">\b0[oO][0-7_]+\b</Rule>
    <Rule color="Number">(?&lt;![\w.])(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?\b</Rule>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Constant">\b[A-Z][A-Z0-9_]{2,}\b</Rule>
    <Rule color="Property">(?&lt;=-&gt;|\?-&gt;|::)[A-Za-z_]\w*\b</Rule>
    <Rule color="Type">\b[A-Z]\w*\b</Rule>
    <Rule color="Operator">=&gt;|\?-&gt;|-&gt;|::|\?\?=?|\.\.\.|[-+*/%=&lt;&gt;!&amp;|^~?.@]+</Rule>
    <Rule color="Punctuation">[{}()\[\];,:]</Rule>
  </RuleSet>
</SyntaxDefinition>

<?xml version="1.0" encoding="utf-8"?>
<!-- BetterNotepad syntax definition: C. Colors are SyntaxToken names; the active theme paints them. -->
<SyntaxDefinition name="C" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" exampleText="public static void"/>
  <Color name="Control" exampleText="if (x) return;"/>
  <Color name="Type" exampleText="int string"/>
  <Color name="Function" exampleText="Foo(bar)"/>
  <Color name="Property" exampleText="obj.Name"/>
  <Color name="String" exampleText="&quot;text&quot;"/>
  <Color name="Number" exampleText="0xFF 3.14"/>
  <Color name="Constant" exampleText="true null"/>
  <Color name="Comment" exampleText="// comment"/>
  <Color name="DocComment" exampleText="/// summary"/>
  <Color name="Preprocessor" exampleText="#include"/>
  <Color name="Operator" exampleText="+ - =&gt;"/>
  <Color name="Punctuation" exampleText="{ } ( ) ;"/>
  <Color name="Escape" exampleText="\n \t"/>
  <Color name="Directive" exampleText=".text"/>
  <Color name="Label" exampleText="loop:"/>
  <Color name="Link" exampleText="[text](url)"/>

  <RuleSet>
    <Span color="DocComment" multiline="true" ruleSet="Doc" begin="/\*[*!](?![*/])" end="\*/"/>
    <Span color="DocComment" ruleSet="Doc" begin="///(?!/)|//!"/>
    <Span color="Comment" multiline="true" ruleSet="Cmt" begin="/\*(?![*!](?![*/]))" end="\*/"/>
    <Span color="Comment" ruleSet="Cmt" begin="//(?!/(?!/))"/>
    <Rule color="Preprocessor">^\s*\#\s*(?:include_next|include|import|define|undef|ifdef|ifndef|if|elif|elifdef|elifndef|else|endif|error|warning|pragma|line|using|region|endregion)\b</Rule>
    <Rule color="String">(?&lt;=^\s*\#\s*(?:include_next|include|import)\s*)&lt;[^&gt;\n]*&gt;</Rule>
    <Rule color="Constant">(?&lt;=^\s*\#\s*(?:define|undef|ifdef|ifndef|elifdef|elifndef)\s+)[A-Za-z_]\w*</Rule>
    <Span color="String" ruleSet="Esc" begin="(?:\b(?:u8|u|U|L))?&quot;" end="&quot;"/>
    <Span color="String" ruleSet="Esc" begin="(?:(?&lt;!\w)(?:u8|u|U|L)|(?&lt;!\w))'" end="'"/>
    <Rule color="Control">\b(?:continue|default|return|switch|break|while|case|else|goto|for|do|if)\b</Rule>
    <Rule color="Keyword">\b(?:
      _Static_assert|_Thread_local|__attribute__|__forceinline|static_assert|thread_local|__declspec|
      __inline__|__restrict|__typeof__|_Noreturn|_Alignas|_Alignof|_Generic|noreturn|register|restrict|
      volatile|_Atomic|_Pragma|__asm__|alignas|alignof|defined|typedef|extern|inline|sizeof|static|struct|
      typeof|__asm|const|union|auto|enum|asm
    )\b</Rule>
    <Rule color="Type">\b(?:
      sig_atomic_t|max_align_t|WNDCLASSEX|_Imaginary|DWORD_PTR|HINSTANCE|ULONG_PTR|mbstate_t|ptrdiff_t|
      uintmax_t|uintptr_t|COLORREF|NTSTATUS|WNDCLASS|_Complex|char16_t|char32_t|intmax_t|intptr_t|
      uint16_t|uint32_t|uint64_t|unsigned|BOOLEAN|HMODULE|HRESULT|LPCTSTR|LPCWSTR|LPDWORD|LRESULT|SSIZE_T|
      clock_t|errno_t|int16_t|int32_t|int64_t|jmp_buf|ssize_t|uint8_t|va_list|wchar_t|HANDLE|HBRUSH|
      LPARAM|LPBYTE|LPCSTR|LPTSTR|LPVOID|LPWSTR|PCWSTR|SIZE_T|SOCKET|UINT16|UINT32|UINT64|WPARAM|double|
      fpos_t|int8_t|ldiv_t|signed|size_t|time_t|DWORD|HICON|HMENU|INT16|INT32|INT64|LPSTR|PCHAR|POINT|
      PVOID|PWSTR|QWORD|TCHAR|UINT8|ULONG|_Bool|div_t|float|off_t|pid_t|short|ATOM|BOOL|BYTE|FILE|HWND|
      INT8|LONG|RECT|SIZE|UINT|WORD|bool|char|long|void|DIR|HDC|INT|MSG|int
    )\b</Rule>
    <Rule color="Constant">\b(?:
      INVALID_HANDLE_VALUE|EXIT_FAILURE|EXIT_SUCCESS|__FUNCTION__|__COUNTER__|__VA_ARGS__|__cplusplus|
      CHAR_BIT|INFINITE|LONG_MAX|LONG_MIN|MAX_PATH|RAND_MAX|SEEK_CUR|SEEK_END|SEEK_SET|SIZE_MAX|UINT_MAX|
      __DATE__|__FILE__|__LINE__|__STDC__|__TIME__|__func__|INT_MAX|INT_MIN|nullptr|BUFSIZ|stderr|stdout|
      FALSE|errno|false|stdin|NULL|TRUE|true|EOF
    )\b</Rule>
    <Rule color="Type">\b[A-Za-z_]\w*_t\b</Rule>
    <Rule color="Type">(?&lt;=\b(?:struct|union|enum)\s+)[A-Za-z_]\w*</Rule>
    <Rule color="Label">^\s*[A-Za-z_]\w*(?=\s*:(?!:))</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F']+[uUlLzZ]*\b</Rule>
    <Rule color="Number">\b0[bB][01']+[uUlLzZ]*\b</Rule>
    <Rule color="Number">\b0[oO][0-7']+[uUlLzZ]*\b</Rule>
    <Rule color="Number">(?&lt;![\w.])(?:\d[\d']*(?:\.(?!\.)[\d']*)?|\.\d[\d']*)(?:[eE][+-]?\d[\d']*)?[uUlLfFzZ]*\b</Rule>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Constant">\b[A-Z][A-Z0-9_]{2,}\b</Rule>
    <Rule color="Property">(?&lt;=\.|-&gt;)[A-Za-z_]\w*\b</Rule>
    <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
    <Rule color="Punctuation">[{}()\[\];,.:]</Rule>
  </RuleSet>

  <RuleSet name="Esc">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="Cmt">
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="Doc">
    <Rule color="Directive">(?&lt;![\w])[@\\][A-Za-z]+</Rule>
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>
</SyntaxDefinition>

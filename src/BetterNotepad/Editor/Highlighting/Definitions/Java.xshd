<?xml version="1.0" encoding="utf-8"?>
<!-- BetterNotepad syntax definition: Java. Colors are SyntaxToken names; the active theme paints them. -->
<SyntaxDefinition name="Java" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" exampleText="public static void"/>
  <Color name="Control" exampleText="if (x) return;"/>
  <Color name="Type" exampleText="int string"/>
  <Color name="Function" exampleText="Foo(bar)"/>
  <Color name="Property" exampleText="obj.Name"/>
  <Color name="String" exampleText="&quot;text&quot;"/>
  <Color name="Number" exampleText="0xFF 3.14"/>
  <Color name="Constant" exampleText="true null"/>
  <Color name="Comment" exampleText="// comment"/>
  <Color name="DocComment" exampleText="/// summary"/>
  <Color name="Operator" exampleText="+ - =&gt;"/>
  <Color name="Punctuation" exampleText="{ } ( ) ;"/>
  <Color name="Attribute" exampleText="[Serializable]"/>
  <Color name="Escape" exampleText="\n \t"/>
  <Color name="Directive" exampleText=".text"/>
  <Color name="Link" exampleText="[text](url)"/>

  <RuleSet>
    <Span color="DocComment" multiline="true" ruleSet="Doc" begin="/\*[*!](?![*/])" end="\*/"/>
    <Span color="Comment" multiline="true" ruleSet="Cmt" begin="/\*(?![*!](?![*/]))" end="\*/"/>
    <Span color="Comment" ruleSet="Cmt" begin="//"/>
    <Span color="String" multiline="true" ruleSet="Esc" begin="&quot;&quot;&quot;" end="&quot;&quot;&quot;"/>
    <Span color="String" ruleSet="Esc" begin="&quot;(?!&quot;&quot;)" end="&quot;"/>
    <Span color="String" ruleSet="Esc" begin="'" end="'"/>
    <Rule color="Keyword">(?&lt;![\w.$])record\b(?=\s+[A-Z]\w*\s*[(&lt;])</Rule>
    <Rule color="Attribute">@(?!interface\b)[A-Za-z_][\w.]*</Rule>
    <Rule color="Control">(?&lt;![\w.$])(?:continue|default|finally|assert|return|switch|break|catch|throw|while|yield|case|else|for|try|do|if)\b</Rule>
    <Rule color="Keyword">(?&lt;![\w.$])(?:
      synchronized|implements|instanceof|interface|protected|transient|abstract|strictfp|volatile|extends|
      package|permits|private|import|native|public|sealed|static|throws|class|final|super|enum|this|new|
      var
    )\b</Rule>
    <Rule color="Type">(?&lt;![\w.$])(?:boolean|double|float|short|byte|char|long|void|int)\b</Rule>
    <Rule color="Constant">(?&lt;![\w.$])(?:false|null|true)\b</Rule>
    <Rule color="Type">(?&lt;=\b(?:new|class|interface|enum|record|extends|implements|throws|instanceof)\s+)[A-Za-z_]\w*</Rule>
    <Rule color="Type">(?&lt;=\bimport\s+(?:static\s+)?(?:[a-z]\w*\.)+)[A-Z]\w*</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F_]+[lL]?\b</Rule>
    <Rule color="Number">\b0[bB][01_]+[lL]?\b</Rule>
    <Rule color="Number">\b0[oO][0-7_]+[lL]?\b</Rule>
    <Rule color="Number">(?&lt;![\w.])(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?[lLfFdD]?\b</Rule>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Constant">\b[A-Z][A-Z0-9_]{2,}\b</Rule>
    <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*\b</Rule>
    <Rule color="Type">\b[A-Z]\w*\b</Rule>
    <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
    <Rule color="Punctuation">[{}()\[\];,.:]</Rule>
  </RuleSet>

  <RuleSet name="Esc">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="Cmt">
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="Doc">
    <Rule color="Directive">(?&lt;![\w])[@\\][A-Za-z]+</Rule>
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>
</SyntaxDefinition>

<?xml version="1.0" encoding="utf-8"?>
<!-- BetterNotepad syntax definition: Toml. Colors are SyntaxToken names; the active theme paints them. -->
<SyntaxDefinition name="Toml" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="String" exampleText="&quot;text&quot;"/>
  <Color name="Number" exampleText="0xFF 3.14"/>
  <Color name="Constant" exampleText="true null"/>
  <Color name="Comment" exampleText="// comment"/>
  <Color name="Operator" exampleText="+ - =&gt;"/>
  <Color name="Punctuation" exampleText="{ } ( ) ;"/>
  <Color name="Escape" exampleText="\n \t"/>
  <Color name="Directive" exampleText=".text"/>
  <Color name="Link" exampleText="[text](url)"/>
  <Color name="Key" exampleText="name:"/>
  <Color name="Section" exampleText="[section]"/>

  <RuleSet>
    <Span color="Comment" ruleSet="Cmt" begin="\#"/>
    <Rule color="Section">^\s*\[\[?[^\]\n]*\]\]?</Rule>
    <Span color="String" multiline="true" ruleSet="Esc" begin="&quot;&quot;&quot;" end="&quot;&quot;&quot;"/>
    <Span color="String" multiline="true" begin="'''" end="'''"/>
    <Rule color="Key">^\s*(?:\"[^\"\n]*\"|'[^'\n]*'|[A-Za-z0-9_-]+)(?:\s*\.\s*(?:\"[^\"\n]*\"|'[^'\n]*'|[A-Za-z0-9_-]+))*(?=\s*=)</Rule>
    <Span color="String" ruleSet="Esc" begin="(?&lt;=(?:=|,|\[|\{)\s*)&quot;(?!&quot;&quot;)" end="&quot;"/>
    <Span color="String" begin="(?&lt;=(?:=|,|\[|\{)\s*)'(?!'')" end="'"/>
    <Rule color="Constant">(?&lt;![\w.-])[-+]?(?:false|true|inf|nan)\b</Rule>
    <Rule color="Number">\b\d{4}-\d{2}-\d{2}(?:[Tt ]\d{2}:\d{2}:\d{2}(?:\.\d+)?(?:[Zz]|[+-]\d{2}:\d{2})?)?\b|\b\d{2}:\d{2}:\d{2}(?:\.\d+)?\b</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F_]+\b</Rule>
    <Rule color="Number">\b0[bB][01_]+\b</Rule>
    <Rule color="Number">\b0[oO][0-7_]+\b</Rule>
    <Rule color="Number">(?&lt;![\w.])(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?\b</Rule>
    <Rule color="Operator">=</Rule>
    <Rule color="Punctuation">[\[\]{},.]</Rule>
  </RuleSet>

  <RuleSet name="Esc">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="Cmt">
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="Doc">
    <Rule color="Directive">(?&lt;![\w])[@\\][A-Za-z]+</Rule>
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>
</SyntaxDefinition>

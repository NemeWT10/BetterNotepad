<?xml version="1.0" encoding="utf-8"?>
<!-- BetterNotepad syntax definition: Swift. Colors are SyntaxToken names; the active theme paints them. -->
<SyntaxDefinition name="Swift" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Keyword" exampleText="public static void"/>
  <Color name="Control" exampleText="if (x) return;"/>
  <Color name="Type" exampleText="int string"/>
  <Color name="Function" exampleText="Foo(bar)"/>
  <Color name="Variable" exampleText="$value"/>
  <Color name="Property" exampleText="obj.Name"/>
  <Color name="String" exampleText="&quot;text&quot;"/>
  <Color name="Number" exampleText="0xFF 3.14"/>
  <Color name="Constant" exampleText="true null"/>
  <Color name="Comment" exampleText="// comment"/>
  <Color name="DocComment" exampleText="/// summary"/>
  <Color name="Preprocessor" exampleText="#include"/>
  <Color name="Operator" exampleText="+ - =&gt;"/>
  <Color name="Punctuation" exampleText="{ } ( ) ;"/>
  <Color name="Attribute" exampleText="[Serializable]"/>
  <Color name="Escape" exampleText="\n \t"/>
  <Color name="Directive" exampleText=".text"/>
  <Color name="Link" exampleText="[text](url)"/>

  <RuleSet>
    <Span color="DocComment" multiline="true" ruleSet="Doc" begin="/\*[*!](?![*/])" end="\*/"/>
    <Span color="DocComment" ruleSet="Doc" begin="///(?!/)"/>
    <Span color="Comment" multiline="true" ruleSet="Cmt" begin="/\*(?![*!](?![*/]))" end="\*/"/>
    <Span color="Comment" ruleSet="Cmt" begin="//(?!/(?!/))"/>
    <Span color="String" multiline="true" ruleSet="SwEsc" begin="&quot;&quot;&quot;" end="&quot;&quot;&quot;"/>
    <Span color="String" ruleSet="SwEsc" begin="&quot;(?!&quot;&quot;)" end="&quot;"/>
    <Rule color="Preprocessor">\#[A-Za-z]+\b</Rule>
    <Rule color="Attribute">@[A-Za-z_]\w*</Rule>
    <Rule color="Variable">\$\d+|(?&lt;=[\s(,])\$[A-Za-z_]\w*</Rule>
    <Rule color="Control">(?&lt;![\w.])(?:
      fallthrough|continue|default|repeat|return|switch|break|catch|defer|guard|throw|where|while|case|
      else|for|try|do|if
    )\b</Rule>
    <Rule color="Keyword">(?&lt;![\w.])(?:
      precedencegroup|associatedtype|convenience|fileprivate|nonisolated|nonmutating|extension|subscript|
      typealias|indirect|internal|isolated|mutating|operator|optional|override|protocol|required|rethrows|
      dynamic|private|unowned|willSet|deinit|didSet|import|public|static|struct|throws|actor|async|await|
      class|final|inout|super|enum|func|init|lazy|open|self|some|weak|Any|any|let|var|as|is
    )\b</Rule>
    <Rule color="Keyword">(?&lt;![\w.])(?:get|set)\b(?=\s*[{(])</Rule>
    <Rule color="Constant">(?&lt;![\w.])(?:false|true|nil)\b</Rule>
    <Rule color="Type">(?&lt;=\b(?:class|struct|enum|protocol|extension|typealias|actor)\s+)[A-Za-z_]\w*</Rule>
    <Rule color="Number">\b0[xX][0-9a-fA-F_]+\b</Rule>
    <Rule color="Number">\b0[bB][01_]+\b</Rule>
    <Rule color="Number">\b0[oO][0-7_]+\b</Rule>
    <Rule color="Number">(?:(?&lt;![\w.])|(?&lt;=\.\.))(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?\b</Rule>
    <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
    <Rule color="Property">(?&lt;=[{(,;]\s*|^\s*)[A-Za-z_]\w*(?=\s*\??:(?![:=]))</Rule>
    <Rule color="Constant">\b[A-Z][A-Z0-9_]{2,}\b</Rule>
    <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*\b</Rule>
    <Rule color="Type">\b[A-Z]\w*\b</Rule>
    <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
    <Rule color="Punctuation">[{}()\[\];,.:]</Rule>
  </RuleSet>

  <RuleSet name="Esc">
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
  </RuleSet>

  <RuleSet name="Cmt">
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="Doc">
    <Rule color="Directive">(?&lt;![\w])[@\\][A-Za-z]+</Rule>
    <Rule color="Link">\b(?:https?|ftp|file)://[^\s&lt;&gt;\"'`)\]]+</Rule>
  </RuleSet>

  <RuleSet name="SwEsc">
    <Span color="Variable">
      <Begin color="Punctuation">\\\(</Begin>
      <End color="Punctuation">\)</End>
      <RuleSet>
        <Span color="String" ruleSet="SwEsc" begin="&quot;" end="&quot;"/>
        <Rule color="Keyword">(?&lt;![\w.])(?:await|super|self|try|as|is)\b</Rule>
        <Rule color="Constant">(?&lt;![\w.])(?:false|true|nil)\b</Rule>
        <Rule color="Number">\b0[xX][0-9a-fA-F_]+\b</Rule>
        <Rule color="Number">\b0[bB][01_]+\b</Rule>
        <Rule color="Number">\b0[oO][0-7_]+\b</Rule>
        <Rule color="Number">(?:(?&lt;![\w.])|(?&lt;=\.\.))(?:\d[\d_]*(?:\.(?!\.)[\d_]*)?|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?\b</Rule>
        <Rule color="Function">\b[A-Za-z_]\w*(?=\s*\()</Rule>
        <Rule color="Property">(?&lt;=[{(,;]\s*|^\s*)[A-Za-z_]\w*(?=\s*\??:(?![:=]))</Rule>
        <Rule color="Property">(?&lt;=\.)[A-Za-z_]\w*\b</Rule>
        <Rule color="Type">\b[A-Z]\w*\b</Rule>
        <Rule color="Operator">[-+*%=&lt;&gt;!&amp;|^~?]+|/(?![/*])=?</Rule>
        <Rule color="Punctuation">[()\[\],.]+</Rule>
      </RuleSet>
    </Span>
    <Span color="Escape" begin="\\(?:x[0-9A-Fa-f]{1,2}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|u\{[0-9A-Fa-f]+\}|[0-7]{1,3}|.)" end="(?=.)"/>
  </RuleSet>
</SyntaxDefinition>

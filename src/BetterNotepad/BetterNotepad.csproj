<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <!-- App.xaml is a Page: Program.Main creates the App, calls InitializeComponent and Run. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>BetterNotepad.Program</StartupObject>
    <AssemblyName>BetterNotepad</AssemblyName>
    <RootNamespace>BetterNotepad</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Lean runtime: workstation GC without the background GC thread, conserve memory. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- No dynamic PGO: measured (tools\perf.ps1, 10 code tabs, published exe) ~35 % less CPU while working and 5-9 MB less
         memory; the instrumented tier buys a notepad nothing. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BetterNotepad.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BetterNotepad.Markdown\BetterNotepad.Markdown.csproj" />
    <ProjectReference Include="..\BetterNotepad.Hex\BetterNotepad.Hex.csproj" />
    <ProjectReference Include="..\BetterNotepad.Metadata\BetterNotepad.Metadata.csproj" />
    <ProjectReference Include="..\BetterNotepad.Pdf\BetterNotepad.Pdf.csproj" />
    <ProjectReference Include="..\BetterNotepad.Html\BetterNotepad.Html.csproj" />
    <ProjectReference Include="..\BetterNotepad.Imaging\BetterNotepad.Imaging.csproj" />
    <ProjectReference Include="..\BetterNotepad.Tabular.Wpf\BetterNotepad.Tabular.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <EmbeddedResource Include="Editor\Highlighting\Definitions\*.xshd" />
  </ItemGroup>

</Project>

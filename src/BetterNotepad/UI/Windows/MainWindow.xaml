<Window x:Class="BetterNotepad.UI.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BetterNotepad.Core.Localization"
        xmlns:c="clr-namespace:BetterNotepad.UI.Controls"
        xmlns:ui="clr-namespace:BetterNotepad.UI"
        Title="BetterNotepad" Width="1180" Height="760" MinWidth="560" MinHeight="380"
        Background="{DynamicResource Brush.WindowBg}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Ui}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="Manual" AllowDrop="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- WindowShell / PinFrame / PinShadow matter only for a tab pinned on top (a per-pixel transparent window): the frame is a slim
         rounded card with its own soft shadow. A normal window shows Root directly (no margin, border or shadow). -->
    <Grid x:Name="WindowShell">
    <Border x:Name="PinShadow" Visibility="Collapsed" CornerRadius="10" Background="{DynamicResource Brush.Bg}" IsHitTestVisible="False">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Direction="270" Opacity="0.4" Color="{DynamicResource Color.Shadow}"/>
        </Border.Effect>
    </Border>
    <Border x:Name="PinFrame">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ───── title bar: one 40 px row; app icon + menu | palette pill centered in the free space | tools | caption buttons ───── -->
        <Border x:Name="TitleBack" Grid.Row="0" Background="{DynamicResource Brush.Chrome}"/>
        <!-- hairline under the title row: the title bar and the tab strip share one color, so without it the caption
             buttons' full-height hover (46 x 40) would end in the middle of the band, just above the tabs, and look cut off -->
        <Border x:Name="TitleLine" Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Border}"/>
        <Grid x:Name="TitleBar" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image x:Name="AppIcon" Width="16" Height="16" Margin="15,0,9,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" WindowChrome.IsHitTestVisibleInChrome="False"/>
                <Menu x:Name="TopMenu" Style="{StaticResource TopMenu}" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True"/>
            </StackPanel>

            <!-- command palette pill: up to 440 px, centered in the free space; shrinks to an icon (code-behind) -->
            <Button x:Name="PalettePill" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    MaxWidth="440" Height="30" Margin="16,0" Cursor="Hand" Focusable="False"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="OnPalettePill" SizeChanged="OnPillSizeChanged">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource Brush.BgAlt}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="10,0,6,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <c:Icon x:Name="PillIcon" Glyph="&#xE721;" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextFaint}"/>
                                <TextBlock x:Name="PillLabel" Grid.Column="1" Text="{l:Tr palette.pill}" FontSize="12" Margin="8,0,8,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.TextFaint}"/>
                                <Border x:Name="PillKeysChip" Grid.Column="2" CornerRadius="5" Padding="6,1,6,2" VerticalAlignment="Center"
                                        Background="{DynamicResource Brush.SurfaceHover}">
                                    <TextBlock x:Name="PillKeys" FontSize="11" Foreground="{DynamicResource Brush.TextFaint}" Text="Ctrl+P"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.SurfaceHover}"/>
                                <Setter TargetName="PillLabel" Property="Foreground" Value="{DynamicResource Brush.TextDim}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- window tools: same 32 px squares, centered on the caption buttons' axis -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <ToggleButton x:Name="PinButton" Style="{StaticResource IconButton}" Width="32" Height="32" Margin="0,0,2,0" Visibility="Collapsed"
                              WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{l:Tr window.pinTip}" Click="OnPinToggle">
                    <c:Icon Glyph="&#xE718;" FontSize="14"/>
                </ToggleButton>
                <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Width="32" Height="32"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{l:Tr settings.title}" Click="OnSettingsButton">
                    <c:Icon Glyph="&#xE713;" FontSize="15"/>
                </Button>
            </StackPanel>

            <!-- caption buttons: 46 x 40, flush with the top edge -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="MinButton" Style="{StaticResource ChromeButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMinimize">
                    <c:Icon Glyph="&#xE921;" FontSize="10"/>
                </Button>
                <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnMaximize">
                    <c:Icon x:Name="MaxGlyph" Glyph="&#xE922;" FontSize="10"/>
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource ChromeCloseButton}" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnCloseButton">
                    <c:Icon Glyph="&#xE8BB;" FontSize="10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ───── Explorer (folder tree, slides in from the left) | tab groups ───── -->
        <Grid x:Name="WorkArea" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid x:Name="ExplorerSlot" Width="0" Visibility="Collapsed" ClipToBounds="True"/>
            <Grid x:Name="GroupsHost" Grid.Column="1"/>
        </Grid>

        <!-- ───── status bar ───── -->
        <c:StatusBarView x:Name="Status" Grid.Row="2"/>

        <!-- ───── overlays ───── -->
        <Grid x:Name="OverlayLayer" Grid.Row="1" Grid.RowSpan="2"/>
        <ui:DialogHost x:Name="Dialogs" Grid.RowSpan="3"/>
    </Grid>
    </Border>
    <!-- toasts over everything (bottom right); in a ghost window they stay fully readable while the card fades -->
    <ui:ToastHost x:Name="ToastLayer"/>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <!-- Validates every .xshd in Editor/Highlighting/Definitions: loads, checks color names against the SyntaxToken list,
       builds with a sibling resolver and runs DocumentHighlighter over Samples.txt. Does not reference the app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>XshdCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

</Project>
